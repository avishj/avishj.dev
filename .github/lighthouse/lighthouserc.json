{
  "ci": {
    "collect": {
      "settings": {
        "preset": "desktop",
        "throttling": {
          "cpuSlowdownMultiplier": 1
        },
        "screenEmulation": {
          "mobile": false,
          "width": 1350,
          "height": 940,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "formFactor": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      },
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95 }, "error", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }, "error", { "minScore": 0.90 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }, "error", { "minScore": 0.90 }],
        "categories:seo": ["warn", { "minScore": 0.95 }, "error", { "minScore": 0.90 }],

        "first-contentful-paint": ["warn", { "maxNumericValue": 1200 }, "error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1800 }, "error", { "maxNumericValue": 3000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.08 }, "error", { "maxNumericValue": 0.15 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 150 }, "error", { "maxNumericValue": 300 }],
        "speed-index": ["warn", { "maxNumericValue": 3000 }, "error", { "maxNumericValue": 5000 }],
        "interactive": ["warn", { "maxNumericValue": 2000 }, "error", { "maxNumericValue": 3500 }],
        "server-response-time": ["warn", { "maxNumericValue": 600 }],
        "first-cpu-idle": ["warn", { "maxNumericValue": 2000 }],
        "estimated-input-latency": ["warn", { "maxNumericValue": 100 }],
        "redirects": ["error"],
        "uses-text-compression": ["warn"],
        "uses-http2": ["warn"],
        "render-blocking-resources": ["warn"],
        "unminified-css": ["warn"],
        "unminified-javascript": ["warn"],
        "bootup-time": ["warn", { "maxNumericValue": 500 }],
        "viewport": ["error"],
        "doctype": ["error"],
        "charset": ["error"],

        "html-has-lang": ["error"],
        "html-lang-valid": ["error"],
        "document-title": ["error"],
        "meta-viewport": ["error"],
        "link-name": ["warn"],
        "frame-title": ["error"],
        "image-alt": ["warn"],
        "input-image-alt": ["warn"],
        "object-alt": ["warn"],
        "label": ["error"],
        "tabindex": ["warn"],
        "aria-valid-attr": ["warn"],
        "color-contrast": ["warn", { "minScore": 0.7 }],
        "bypass": ["warn"],

        "no-vulnerable-libraries": ["warn"],
        "js-libraries": ["warn"],
        "no-dns-prefetch": ["warn"],
        "http-status-code": ["error"],
        "externally-localize-url": ["warn"],

        "meta-description": ["warn"],
        "document-type": ["error"],
        "anchor-insufficient-state-info": ["warn"],
        "canonical": ["warn"],
        "robots": ["warn"],
        "hreflang": ["warn"],
        "structured-data": ["warn"],
        "is-crawlable": ["warn"]
      }
    }
  }
}
