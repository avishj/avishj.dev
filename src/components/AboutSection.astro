---
// About Section with cursor-trailing line highlight effect
// Text trails from white to grey based on distance from cursor
---

<section id="about" class="about-section relative bg-[--color-bg-primary] pt-4 pb-16 md:pt-6 md:pb-24">
	<div class="max-w-[--max-width]">
		<!-- Section header -->
		<div class="section-header-7 mb-12 flex items-baseline gap-4">
			<span class="text-5xl text-white/50 md:text-6xl" style="font-family: 'Viaoda Libre', serif;">01</span>
			<h2 class="text-5xl italic md:text-6xl" style="font-family: 'Instrument Serif', serif;">About</h2>
		</div>

		<!-- Bio with cursor-trailing opacity -->
		<div class="about-content grid gap-12 md:grid-cols-12">
			<!-- Main bio text -->
			<div class="md:col-span-8">
				<div class="about-text space-y-6 text-xl leading-relaxed md:text-2xl md:leading-relaxed">
					<p class="about-para" data-para="0">
						Hi, I'm <span class="highlight-word">Avish</span>! A software engineer with <span class="highlight-word">1.5 years</span> of experience. <span class="highlight-word">MS Software Engineering</span> graduate from <span class="highlight-word">CMU's School of Computer Science.</span> I love tackling <span class="highlight-word">complex system problems</span> and I'm always looking for something <span class="highlight-word">fun</span> or <span class="highlight-word">challenging :)</span>
					</p>
					<p class="about-para" data-para="1">
						Built <span class="highlight-word">XR remote desktop</span> systems at <span class="highlight-word highlight-snap">Snap</span> and centralized observability for 120+ modules at <span class="highlight-word highlight-siemens">Siemens.</span>
					</p>
					<p class="about-para" data-para="2">
						Previously built warehouse simulation engines and real-time conveyor middleware at <span class="highlight-word highlight-addverb">Addverb.</span> Published in <span class="highlight-word">IEEE</span> and <span class="highlight-word">Springer,</span> former <span class="highlight-word">MITACS</span> research intern.
					</p>
				</div>
			</div>

			<!-- Status card -->
			<div class="md:col-span-4">
				<div class="status-card sticky top-24 rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
					<!-- Availability -->
					<div class="mb-6 flex items-center gap-3">
						<span class="relative flex h-2.5 w-2.5">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
							<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
						</span>
						<span class="text-sm">Available for opportunities</span>
					</div>

					<!-- Quick facts -->
					<div class="space-y-4 border-t border-white/[0.06] pt-6">
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">Education</span>
							<span class="font-mono">CMU SCS</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">QPA</span>
							<span class="font-mono tabular-nums">4.17/4.00</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">Graduating</span>
							<span class="font-mono tabular-nums">Dec 2025</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">Location</span>
							<span class="font-mono">Pittsburgh, PA</span>
						</div>
					</div>

					<!-- Resume link -->
					<a href="mailto:avishj@cs.cmu.edu" class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl border border-white/20 py-3 text-sm transition-all duration-200 hover:border-white/40 hover:bg-white/5">
						<span>Get in touch</span>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const paras = document.querySelectorAll(".about-para");
	const textContainer = document.querySelector(".about-text");
	let currentParaIndex = -1;
	let isHovering = false;

	// Color values for interpolation
	const activeColor = "rgba(255, 255, 255, 0.95)";
	const mutedColor = "rgba(255, 255, 255, 0.35)";

	// Calculate para distances and apply colors
	function updateParaColors(hoveredIndex: number) {
		paras.forEach((para, index) => {
			const distance = Math.abs(index - hoveredIndex);
			const el = para as HTMLElement;
			const highlights = el.querySelectorAll(".highlight-word");

			if (distance === 0) {
				el.style.color = activeColor;
				highlights.forEach((h) => {
					const highlight = h as HTMLElement;
					if (highlight.classList.contains("highlight-snap")) {
						highlight.style.color = "var(--color-accent-snap)";
					} else if (highlight.classList.contains("highlight-siemens")) {
						highlight.style.color = "var(--color-accent-siemens)";
					} else if (highlight.classList.contains("highlight-addverb")) {
						highlight.style.color = "var(--color-accent-addverb)";
					} else {
						highlight.style.color = "rgba(255, 255, 255, 1)";
					}
				});
			} else {
				const opacity = Math.max(0.35, 0.95 - distance * 0.25);
				el.style.color = `rgba(255, 255, 255, ${opacity})`;

				highlights.forEach((h) => {
					const highlight = h as HTMLElement;
					const brandOpacity = Math.max(0.6, 1 - distance * 0.15);
					if (highlight.classList.contains("highlight-snap")) {
						highlight.style.color = `color-mix(in srgb, var(--color-accent-snap) ${brandOpacity * 100}%, transparent)`;
					} else if (highlight.classList.contains("highlight-siemens")) {
						highlight.style.color = `color-mix(in srgb, var(--color-accent-siemens) ${brandOpacity * 100}%, transparent)`;
					} else if (highlight.classList.contains("highlight-addverb")) {
						highlight.style.color = `color-mix(in srgb, var(--color-accent-addverb) ${brandOpacity * 100}%, transparent)`;
					} else {
						highlight.style.color = `rgba(255, 255, 255, ${Math.min(1, opacity + 0.2)})`;
					}
				});
			}
		});
	}

	// Reset to default muted state
	function resetToDefault() {
		paras.forEach((para) => {
			const el = para as HTMLElement;
			el.style.color = mutedColor;

			const highlights = el.querySelectorAll(".highlight-word");
			highlights.forEach((h) => {
				const highlight = h as HTMLElement;
				if (highlight.classList.contains("highlight-snap")) {
					highlight.style.color = "var(--color-accent-snap)";
				} else if (highlight.classList.contains("highlight-siemens")) {
					highlight.style.color = "var(--color-accent-siemens)";
				} else if (highlight.classList.contains("highlight-addverb")) {
					highlight.style.color = "var(--color-accent-addverb)";
				} else {
					highlight.style.color = "rgba(255, 255, 255, 0.7)";
				}
			});
		});
	}

	// Set up event listeners for each paragraph
	paras.forEach((para, index) => {
		para.addEventListener("mouseenter", () => {
			isHovering = true;
			currentParaIndex = index;
			updateParaColors(index);
		});
	});

	// Handle mouse leave on container - triggers the trailing fade
	if (textContainer) {
		textContainer.addEventListener("mouseleave", () => {
			isHovering = false;
			currentParaIndex = -1;
			resetToDefault();
		});
	}

	// Initial state
	resetToDefault();

	// Paragraph entrance animation on scroll
	paras.forEach((para, index) => {
		gsap.fromTo(
			para,
			{ y: 20, opacity: 0 },
			{
				y: 0,
				opacity: 1,
				duration: 0.8,
				ease: "power3.out",
				scrollTrigger: {
					trigger: para,
					start: "top 85%",
					toggleActions: "play none none reverse"
				},
				delay: index * 0.15
			}
		);
	});

	// Status card animation
	const statusCard = document.querySelector(".status-card");
	if (statusCard) {
		gsap.fromTo(
			statusCard,
			{ x: 30, opacity: 0 },
			{
				x: 0,
				opacity: 1,
				duration: 0.8,
				ease: "power4.out",
				scrollTrigger: {
					trigger: statusCard,
					start: "top 80%",
					toggleActions: "play none none reverse"
				},
				delay: 0.3
			}
		);
	}
</script>

<style>
	.about-para {
		color: rgba(255, 255, 255, 0.35);
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		cursor: default;
	}

	.highlight-word {
		font-weight: 500;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.highlight-snap {
		color: var(--color-accent-snap);
	}

	.highlight-siemens {
		color: var(--color-accent-siemens);
	}

	.highlight-addverb {
		color: var(--color-accent-addverb);
	}
</style>
