---
// About Section with cursor-trailing line highlight effect
// Text trails from white to grey based on distance from cursor
import SectionHeader from './SectionHeader.astro';
---

<section id="about" class="about-section relative bg-[--color-bg-primary] pt-4 pb-16 md:pt-6 md:pb-24">
	<div class="max-w-(--max-width)">
		<SectionHeader number="01" title="About" class="mb-12" />

		<!-- Bio with cursor-trailing opacity -->
		<div class="about-content grid gap-12 md:grid-cols-12">
			<!-- Main bio text -->
			<div class="md:col-span-8">
				<div class="about-text space-y-6 text-xl leading-relaxed md:text-2xl md:leading-relaxed">
					<p class="about-para">Hi, I'm <span class="hw">Avish</span>! A software engineer with <span class="hw">1.5 years</span> of industry experience and an <span class="hw">MS Software Engineering</span> from <span class="hw">CMU's School of Computer Science.</span> I love tackling <span class="hw">complex system problems</span> and I'm always looking for something <span class="hw">fun</span> or <span class="hw">challenging :)</span></p>
					<p class="about-para">Built <span class="hw">XR remote desktop</span> systems at <span class="hw hw-snap">Snap</span> and centralized observability for 120+ modules at <span class="hw hw-siemens">Siemens.</span></p>
					<p class="about-para">Previously built warehouse simulation engines and real-time conveyor middleware at <span class="hw hw-addverb">Addverb.</span> Published in <span class="hw">IEEE</span> and <span class="hw">Springer,</span> former <span class="hw hw-mitacs">MITACS</span> research intern. Also worked at <span class="hw hw-ey">Ernst & Young</span> and <span class="hw hw-tata">Tata Steel.</span></p>
				</div>
			</div>

			<!-- Status card -->
			<div class="md:col-span-4">
				<div class="status-card sticky top-24 rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
					<!-- Availability -->
					<div class="mb-6 flex items-center gap-3" role="status" aria-label="Available for opportunities">
						<span class="relative flex h-2.5 w-2.5" aria-hidden="true">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
							<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
						</span>
						<span class="text-sm">Available for opportunities</span>
					</div>

					<!-- Quick facts -->
					<div class="space-y-4 border-t border-white/[0.06] pt-6">
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">Education</span>
							<span class="font-mono">CMU SCS</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">QPA</span>
							<span class="font-mono tabular-nums">4.17/4.00</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">Graduating</span>
							<span class="font-mono tabular-nums">Dec 2025</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-[--color-text-muted]">Location</span>
							<span class="font-mono">Pittsburgh, PA</span>
						</div>
					</div>

					<!-- Resume link -->
					<a href="mailto:avishj@cs.cmu.edu" class="status-cta mt-6 flex w-full items-center justify-center gap-2 rounded-xl border border-white/20 py-3 text-sm transition-all duration-150 active:scale-[0.97]">
						<span>Get in touch</span>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const textContainer = document.querySelector(".about-text") as HTMLElement;
	const paras = document.querySelectorAll(".about-para");
	let wordSpans: HTMLSpanElement[] = [];
	let currentLineY = -1;

	const companyColors: Record<string, string> = {
		'hw-snap': 'var(--color-accent-snap)',
		'hw-siemens': 'var(--color-accent-siemens)',
		'hw-addverb': 'var(--color-accent-addverb)',
		'hw-mitacs': 'var(--color-accent-mitacs)',
		'hw-ey': 'var(--color-accent-ey)',
		'hw-tata': 'var(--color-accent-tata)',
	};

	function getAccentColor(el: HTMLElement): string | null {
		for (const [cls, cssVar] of Object.entries(companyColors)) {
			if (el.classList.contains(cls)) return cssVar;
		}
		return null;
	}

	// Wrap text nodes in word spans for line detection (skip highlights)
	function wrapWords() {
		paras.forEach((para) => {
			const walker = document.createTreeWalker(para, NodeFilter.SHOW_TEXT, {
				acceptNode: (node) => {
					// Skip text inside .hw highlights
					if ((node.parentElement as HTMLElement)?.closest(".hw")) {
						return NodeFilter.FILTER_REJECT;
					}
					return node.textContent?.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
				}
			});
			const textNodes: Text[] = [];
			let node: Text | null;
			while ((node = walker.nextNode() as Text)) {
				textNodes.push(node);
			}

			textNodes.forEach((textNode) => {
				const words = textNode.textContent!.split(/(\s+)/);
				const fragment = document.createDocumentFragment();

				words.forEach((word) => {
					if (word.trim()) {
						const span = document.createElement("span");
						span.className = "about-word";
						span.textContent = word;
						fragment.appendChild(span);
						wordSpans.push(span);
					} else if (word) {
						fragment.appendChild(document.createTextNode(word));
					}
				});

				textNode.parentNode?.replaceChild(fragment, textNode);
			});
		});
	}

	// Group words by their visual line (Y position)
	function getLineGroups(): Map<number, HTMLSpanElement[]> {
		const lines = new Map<number, HTMLSpanElement[]>();
		const tolerance = 5;

		wordSpans.forEach((span) => {
			const rect = span.getBoundingClientRect();
			const y = Math.round(rect.top / tolerance) * tolerance;

			let foundLine = false;
			for (const [lineY] of lines) {
				if (Math.abs(lineY - y) < tolerance) {
					lines.get(lineY)!.push(span);
					foundLine = true;
					break;
				}
			}
			if (!foundLine) {
				lines.set(y, [span]);
			}
		});

		return lines;
	}

	// Update colors based on cursor Y position - inverted spotlight effect
	function updateColors(cursorY: number) {
		const lines = getLineGroups();
		const sortedLineYs = Array.from(lines.keys()).sort((a, b) => a - b);

		// Find the closest line to cursor
		let closestLineY = sortedLineYs[0];
		let minDist = Infinity;
		sortedLineYs.forEach((lineY) => {
			const dist = Math.abs(lineY - cursorY);
			if (dist < minDist) {
				minDist = dist;
				closestLineY = lineY;
			}
		});

		currentLineY = closestLineY;
		const closestIndex = sortedLineYs.indexOf(closestLineY);

		// Inverted: active line stays bright, others dim based on distance
		sortedLineYs.forEach((lineY, index) => {
			const distance = Math.abs(index - closestIndex);
			const words = lines.get(lineY)!;

			words.forEach((word) => {
				const isHighlight = word.closest(".hw");
				if (isHighlight) return;

				// Active line: full brightness, others fade out
				const opacity = distance === 0 ? 0.9 : Math.max(0.25, 0.7 - distance * 0.15);
				word.style.color = `rgba(255, 255, 255, ${opacity})`;
			});
		});

		// Handle highlights - same inverted logic
		document.querySelectorAll(".hw").forEach((hw) => {
			const el = hw as HTMLElement;
			const rect = el.getBoundingClientRect();
			const hwY = Math.round(rect.top / 5) * 5;

			let hwLineIndex = 0;
			for (let i = 0; i < sortedLineYs.length; i++) {
				if (Math.abs(sortedLineYs[i] - hwY) < 10) {
					hwLineIndex = i;
					break;
				}
			}

			const distance = Math.abs(hwLineIndex - closestIndex);
			const dimAmount = Math.max(0.4, 1 - distance * 0.2);
			const accent = getAccentColor(el);

			if (accent) {
				el.style.color = distance === 0 ? accent : `color-mix(in srgb, ${accent} ${dimAmount * 100}%, transparent)`;
			} else {
				el.style.color = `rgba(255, 255, 255, ${distance === 0 ? 1 : Math.max(0.45, 0.9 - distance * 0.15)})`;
			}
		});
	}

	// Reset to bright readable state
	function resetToDefault() {
		wordSpans.forEach((word) => {
			word.style.color = "rgba(255, 255, 255, 0.8)";
		});

		document.querySelectorAll(".hw").forEach((hw) => {
			const el = hw as HTMLElement;
			el.style.color = getAccentColor(el) ?? "rgba(255, 255, 255, 1)";
		});
	}

	// Initialize
	wrapWords();
	resetToDefault();

	// Mouse move handler
	textContainer?.addEventListener("mousemove", (e) => {
		updateColors(e.clientY);
	});

	textContainer?.addEventListener("mouseleave", () => {
		currentLineY = -1;
		resetToDefault();
	});
    
	const companyMap: Record<string, string> = {
		'hw-snap': '0',
		'hw-siemens': '1',
		'hw-addverb': '2',
		'hw-mitacs': '3',
		'hw-ey': '4',
		'hw-tata': '5'
	};

	Object.entries(companyMap).forEach(([className, dataIndex]) => {
		document.querySelectorAll(`.${className}`).forEach((el) => {
			el.classList.add('company-link');
			el.addEventListener('click', () => {
				const targetCard = document.querySelector(`.exp-card[data-index="${dataIndex}"]`);
				if (targetCard) {
					targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
					// Flash highlight
					targetCard.classList.add('flash-highlight');
					setTimeout(() => targetCard.classList.remove('flash-highlight'), 1200);
				}
			});
		});
	});

	// Paragraph and status card animations - wait for intro
	async function initAboutAnimations() {
		const { scrollReveal, presets } = await import('../utils/scroll-animations');
		const statusCard = document.querySelector(".status-card");

		scrollReveal(paras, presets.fadeUp);
		if (statusCard) {
			scrollReveal(statusCard, { from: { x: 30, opacity: 0 }, to: { x: 0, opacity: 1 } });
		}
	}

	window.addEventListener('intro-complete', () => initAboutAnimations(), { once: true });
</script>

<style>
	.about-para {
		cursor: default;
	}

	.about-word {
		color: rgba(255, 255, 255, 0.8);
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hw {
		font-weight: 500;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hw-snap {
		color: var(--color-accent-snap);
	}

	.hw-siemens {
		color: var(--color-accent-siemens);
	}

	.hw-addverb {
		color: var(--color-accent-addverb);
	}

	.hw-mitacs {
		color: var(--color-accent-mitacs);
	}

	.hw-ey {
		color: var(--color-accent-ey);
	}

	.hw-tata {
		color: var(--color-accent-tata);
	}

	.company-link {
		cursor: pointer;
		position: relative;
		text-decoration: none;
		padding-bottom: 2px;
	}

	.company-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background-image: repeating-linear-gradient(
			to right,
			currentColor 0px,
			currentColor 2px,
			transparent 2px,
			transparent 6px
		);
		background-size: 6px 1px;
		opacity: 0.5;
	}

	/* Touch device protection - only apply hover on devices with pointer */
	@media (hover: hover) and (pointer: fine) {
		.company-link:hover::after {
			opacity: 0.9;
			animation: dotScroll 400ms linear infinite;
		}

		.status-cta:hover {
			border-color: rgba(255, 255, 255, 0.4);
			background: rgba(255, 255, 255, 0.05);
		}
	}
</style>
