---
interface Props {
  class?: string;
  strokeWidth?: number;
  hover?: 'white' | 'accent';
}

const { class: className = 'h-4 w-4', strokeWidth = 1.5, hover } = Astro.props;

const classes = [
  hover && 'arrow-hover',
  hover === 'white' && 'arrow-hover-white',
  hover === 'accent' && 'arrow-hover-accent',
  className,
].filter(Boolean).join(' ');
---

<svg class={classes} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={strokeWidth}>
  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
</svg>

<style>
  .arrow-hover {
    transition:
      color 200ms ease,
      transform 200ms var(--ease-out-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.group):hover > .arrow-hover-white,
    :global(.group):hover .arrow-hover-white {
      color: white;
      transform: rotate(45deg);
    }

    :global(.group):hover > .arrow-hover-accent,
    :global(.group):hover .arrow-hover-accent {
      color: var(--accent);
      transform: rotate(45deg);
    }
  }
</style>
