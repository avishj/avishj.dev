---
interface Props {
	href: string;
	text: string;
}

const { href, text } = Astro.props;
---

<a href={href} class="back-button group flex items-center gap-3 text-white/50 transition-colors hover:text-white/80">
	<svg class="back-button-icon h-5 w-5 rotate-180 transition-transform duration-200 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H7m10 0v10"></path>
	</svg>
	<span class="back-button-text relative font-mono text-base pb-[3px]">{text}</span>
</a>

<style>
	.back-button {
		will-change: transform;
		transition: transform 150ms ease-out;
	}

	@media (hover: hover) and (pointer: fine) {
		.back-button:hover {
			transform: translateX(-2px);
		}

		.back-button:hover .back-button-icon {
			transform: rotate(180deg) translate(2px, -2px);
		}

		.back-button:hover .back-button-text {
			color: rgba(255, 255, 255, 0.9);
		}

		.back-button:hover .back-button-text::after {
			background-image: repeating-linear-gradient(to right, rgba(255, 255, 255, 0.7) 0px, rgba(255, 255, 255, 0.7) 2px, transparent 2px, transparent 6px);
			animation: dotScroll 400ms linear infinite;
		}
	}

	.back-button:active {
		transform: scale(0.97);
	}

	.back-button-text::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		background-image: repeating-linear-gradient(to right, rgba(255, 255, 255, 0.3) 0px, rgba(255, 255, 255, 0.3) 2px, transparent 2px, transparent 6px);
		background-size: 6px 1px;
		will-change: background-position;
	}

	@keyframes dotScroll {
		0% {
			background-position: 0 0;
		}
		100% {
			background-position: 6px 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back-button,
		.back-button-icon {
			transition: none;
		}
		.back-button-text::after {
			animation: none;
		}
	}
</style>
