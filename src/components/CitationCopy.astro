---
import Cite from "citation-js";
const { plugins } = Cite as any;

interface Props {
	bibtex: string;
}

const { bibtex } = Astro.props;

const cslDir = `${process.cwd()}/src/data/csl`;
const cslConfig = plugins.config.get("@csl");

const customStyles: Record<string, string> = {
	ieee: "ieee.csl",
	harvard: "harvard-cite-them-right.csl",
	mla: "modern-language-association-notes.csl",
	chicago: "chicago-notes-bibliography-classic.csl"
};

for (const [name, file] of Object.entries(customStyles)) {
	if (!cslConfig.templates.has(name)) {
		cslConfig.templates.add(name, await Bun.file(`${cslDir}/${file}`).text());
	}
}

const templateMap: Record<string, string> = {
	apa: "apa",
	ieee: "ieee",
	harvard: "harvard",
	mla: "mla",
	chicago: "chicago"
};

const formats: Record<string, string> = { bibtex };

try {
	const cite = new Cite(bibtex);
	for (const [key, template] of Object.entries(templateMap)) {
		formats[key] = cite
			.format("bibliography", {
				format: "text",
				template,
				lang: "en-US"
			})
			.trim();
	}
} catch {
	for (const key of Object.keys(templateMap)) {
		formats[key] = bibtex;
	}
}

const formatLabels: Record<string, string> = {
	bibtex: "BibTeX",
	apa: "APA",
	ieee: "IEEE",
	harvard: "Harvard",
	mla: "MLA",
	chicago: "Chicago"
};
---

<div class="citation-copy" data-formats={JSON.stringify(formats)}>
	<!-- Toggle button -->
	<button class="cite-toggle group flex w-full cursor-pointer items-center gap-2 rounded-lg border border-white/[0.06] px-4 py-3 font-mono text-sm text-[--color-text-muted]">
		<svg class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
			<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
		</svg>
		<span>Cite this paper</span>
		<svg class="cite-chevron ml-auto h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
		</svg>
	</button>

	<!-- Expandable panel -->
	<div class="cite-panel" style="height: 0; overflow: hidden;">
		<div class="cite-panel-inner pt-3">
			<!-- Format tabs -->
			<div class="mb-3 flex flex-wrap gap-1.5">
				{
					Object.entries(formatLabels).map(([key, label]) => (
						<button class:list={["cite-tab cursor-pointer rounded-md px-2.5 py-1 font-mono text-xs transition-colors duration-150", key === "bibtex" ? "bg-white/[0.08] text-white" : "text-white/40 hover:text-white/60"]} data-format={key}>
							{label}
						</button>
					))
				}
			</div>

			<!-- Citation preview -->
			<div class="relative rounded-lg border border-white/[0.06] bg-white/[0.02]">
				<pre class="cite-preview max-h-36 overflow-auto p-4 font-mono text-xs leading-relaxed text-white/60 whitespace-pre-wrap">{formats.bibtex}</pre>

				<!-- Copy button -->
				<button class="cite-copy-btn absolute right-2 top-2 flex cursor-pointer items-center gap-1.5 rounded-md border border-white/[0.06] bg-[#111] px-2.5 py-1.5 font-mono text-xs text-white/50">
					<!-- Clipboard icon -->
					<svg class="cite-copy-icon h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
					</svg>
					<!-- Check icon (hidden by default) -->
					<svg class="cite-check-icon hidden h-3 w-3 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
					</svg>
					<span class="cite-copy-label">Copy</span>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import gsap from "gsap";

	document.querySelectorAll(".citation-copy").forEach((root) => {
		const toggle = root.querySelector(".cite-toggle") as HTMLButtonElement;
		const chevron = root.querySelector(".cite-chevron") as HTMLElement;
		const panel = root.querySelector(".cite-panel") as HTMLElement;
		const panelInner = root.querySelector(".cite-panel-inner") as HTMLElement;
		const preview = root.querySelector(".cite-preview") as HTMLElement;
		const copyBtn = root.querySelector(".cite-copy-btn") as HTMLButtonElement;
		const copyIcon = root.querySelector(".cite-copy-icon") as HTMLElement;
		const checkIcon = root.querySelector(".cite-check-icon") as HTMLElement;
		const copyLabel = root.querySelector(".cite-copy-label") as HTMLElement;
		const formats: Record<string, string> = JSON.parse((root as HTMLElement).dataset.formats || "{}");
		const tabs = root.querySelectorAll(".cite-tab");

		let isOpen = false;
		let activeFormat = "bibtex";
		let copyTimeout: ReturnType<typeof setTimeout> | null = null;

		if (!toggle || !panel) return;

		toggle.addEventListener("click", () => {
			isOpen = !isOpen;

			if (isOpen) {
				const contentHeight = panelInner.offsetHeight;
				gsap.to(panel, {
					height: contentHeight,
					duration: 0.35,
					ease: "cubic-bezier(0.16, 1, 0.3, 1)",
					onComplete: () => {
						panel.style.overflow = "visible";
					}
				});
				gsap.to(chevron, { rotation: 180, duration: 0.25, ease: "power2.out" });
			} else {
				panel.style.overflow = "hidden";
				gsap.to(panel, {
					height: 0,
					duration: 0.25,
					ease: "power2.inOut"
				});
				gsap.to(chevron, { rotation: 0, duration: 0.25, ease: "power2.out" });
			}
		});

		tabs.forEach((tab) => {
			tab.addEventListener("click", () => {
				const format = (tab as HTMLElement).dataset.format || "bibtex";
				if (format === activeFormat) return;

				activeFormat = format;

				tabs.forEach((t) => {
					t.classList.remove("bg-white/[0.08]", "text-white");
					t.classList.add("text-white/40");
				});
				tab.classList.remove("text-white/40");
				tab.classList.add("bg-white/[0.08]", "text-white");

				gsap.to(preview, {
					opacity: 0,
					duration: 0.1,
					onComplete: () => {
						preview.textContent = formats[format] || formats.bibtex || "";
						gsap.to(preview, { opacity: 1, duration: 0.15 });

						const contentHeight = panelInner.offsetHeight;
						gsap.to(panel, {
							height: contentHeight,
							duration: 0.2,
							ease: "power2.out"
						});
					}
				});
			});
		});

		copyBtn.addEventListener("click", async () => {
			const text = formats[activeFormat] || formats.bibtex || "";
			if (!text) return;

			await navigator.clipboard.writeText(text);

			if (copyTimeout) clearTimeout(copyTimeout);

			copyIcon.classList.add("hidden");
			checkIcon.classList.remove("hidden");
			copyLabel.textContent = "Copied";
			copyBtn.classList.add("text-green-400");
			copyBtn.classList.remove("text-white/50");

			copyTimeout = setTimeout(() => {
				copyIcon.classList.remove("hidden");
				checkIcon.classList.add("hidden");
				copyLabel.textContent = "Copy";
				copyBtn.classList.remove("text-green-400");
				copyBtn.classList.add("text-white/50");
			}, 1500);
		});
	});
</script>

<style>
	.cite-toggle {
		will-change: transform;
		transition:
			background-color 200ms ease,
			border-color 200ms ease,
			color 200ms ease,
			transform 200ms var(--ease-out-expo);
	}

	.cite-chevron {
		will-change: transform;
	}

	.cite-copy-btn {
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			color 150ms ease;
	}

	.cite-tab {
		transition:
			background-color 150ms ease,
			color 150ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.cite-toggle:hover {
			background: rgba(255, 255, 255, 0.03);
			border-color: rgba(255, 255, 255, 0.12);
			color: white;
		}

		.cite-toggle:active {
			transform: scale(0.98);
			transition: transform var(--duration-fast) ease;
		}

		.cite-copy-btn:hover {
			background: rgba(255, 255, 255, 0.06);
			border-color: rgba(255, 255, 255, 0.12);
			color: white;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cite-toggle,
		.cite-chevron,
		.cite-copy-btn,
		.cite-tab {
			transition: none;
		}
	}
</style>
