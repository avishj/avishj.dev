---
import SectionHeader from "./SectionHeader.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { url } from "../utils/url";

interface Education {
	institution: string;
	degree: string;
	field: string;
	location: string;
	period: string;
	gpa: string;
	gpaLabel: string;
	href: string;
	accentClass: string;
	coursework: string[];
	honors: string[];
}

const education: Education[] = [
	{
		institution: "Carnegie Mellon University",
		degree: "Master of Software Engineering",
		field: "Scalable Systems",
		location: "Pittsburgh, PA",
		period: "Aug 2024 · Dec 2025",
		gpa: "4.17",
		gpaLabel: "QPA / 4.00",
		href: url("view/cmu"),
		accentClass: "accent-cmu",
		coursework: ["Cloud Computing", "Engineering Data Intensive Scalable Systems", "Design Patterns", "API Design"],
		honors: ["Teaching Assistant: 17-614 Formal Methods", "Treasurer: MSE Leadership Initiative", "Member: Committee on Student Organizations"]
	},
	{
		institution: "Vellore Institute of Technology",
		degree: "Bachelor of Technology",
		field: "Computer Science and Engineering",
		location: "Vellore, India",
		period: "Jul 2019 · Aug 2023",
		gpa: "3.82",
		gpaLabel: "GPA / 4.00",
		href: url("view/vit"),
		accentClass: "accent-vit",
		coursework: [],
		honors: ["Special Achiever's Award", "Executive Board Chairperson: Mozilla Firefox Club", "Projects Head: Sigma Xi Research Society"]
	}
];
---

<section id="education" class="education-section relative bg-[--color-bg-primary] pt-2 pb-16 md:pt-3 md:pb-24">
	<div class="max-w-(--max-width)">
		<SectionHeader number="05" title="Education" />

		<div class="education-list">
			{
				education.map((edu, index) => (
					<a href={edu.href} class:list={["edu-card group/card block border-t border-white/[0.06] py-4 md:py-6", edu.accentClass]} data-index={index}>
						<div class="flex items-start justify-between gap-4">
							<h3 class="edu-institution font-display text-xl font-medium tracking-tight md:text-2xl" style="color: var(--accent);">
								{edu.institution}
							</h3>
							<div class="flex items-center gap-3 flex-shrink-0">
								<div class="hidden items-center gap-2 font-mono text-xs text-white/50 md:flex">
									<span class="tabular-nums">{edu.period}</span>
									<span class="inline-block h-px w-3 bg-white/20" />
									<span>{edu.location}</span>
								</div>
								<span class="edu-arrow flex-shrink-0 text-white/40">
									<ArrowIcon class="h-4 w-4" />
								</span>
							</div>
						</div>

						<div class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
							<p class="text-base text-white/90">
								{edu.degree} · {edu.field}
							</p>
							<span class="gpa-pill rounded-md border px-2 py-0.5 font-mono text-[11px] font-medium leading-none" style="color: var(--accent); background: color-mix(in srgb, var(--accent) 5%, transparent); border-color: color-mix(in srgb, var(--accent) 15%, transparent);">
								{edu.gpaLabel.split("/")[0].trim()} {edu.gpa} / {edu.gpaLabel.split("/")[1].trim()}
							</span>
						</div>

						<div class="mt-1.5 flex items-center gap-2 font-mono text-xs text-white/50 md:hidden">
							<span class="tabular-nums">{edu.period}</span>
							<span class="inline-block h-px w-3 bg-white/20" />
							<span>{edu.location}</span>
						</div>

						{(edu.coursework.length > 0 || edu.honors.length > 0) && (
							<div class="mt-4 flex flex-col gap-4 md:mt-5 md:flex-row md:gap-8">
								{edu.coursework.length > 0 && (
									<div class="edu-block md:flex-1">
										<p class="mb-2 font-mono text-xs uppercase tracking-[0.15em] text-white/50">Relevant Coursework</p>
										<div class="flex flex-wrap gap-1.5">
											{edu.coursework.map((course) => (
												<span class="rounded border border-white/10 px-2.5 py-1 text-sm text-white/70">{course}</span>
											))}
										</div>
									</div>
								)}

								{edu.honors.length > 0 && (
									<div class="edu-block md:flex-1">
										<p class="mb-2 font-mono text-xs uppercase tracking-[0.15em] text-white/50">Honors & Activities</p>
										<ul class="edu-honors space-y-1.5">
											{edu.honors.map((honor) => (
												<li class="edu-honor flex gap-2.5 text-sm leading-relaxed text-white/70">
													<span class="honor-dot mt-[7px] h-1 w-1 flex-shrink-0 rounded-full" style="background: color-mix(in srgb, var(--accent) 60%, transparent);" />
													<span>{honor}</span>
												</li>
											))}
										</ul>
									</div>
								)}
							</div>
						)}
					</a>
				))
			}
			<div class="border-t border-white/[0.06]"></div>
		</div>
	</div>
</section>

<script>
	async function initEducationAnimations() {
		const { scrollRevealTimeline, tlFadeUp, TIMELINE_OVERLAP } = await import("../utils/scroll-animations");

		const cards = document.querySelectorAll(".edu-card");
		cards.forEach((card) => {
			const institution = card.querySelector(".edu-institution");
			const degreeRow = card.querySelector(".mt-1.flex.flex-wrap");
			const desktopDate = card.querySelector(".hidden.md\\:flex");
			const arrow = card.querySelector(".edu-arrow");
			const mobileDate = card.querySelector(".md\\:hidden");
			const blocks = card.querySelectorAll(".edu-block");

			const metaElements = [degreeRow, desktopDate, mobileDate].filter((el): el is Element => el !== null);

			scrollRevealTimeline(card, (tl) => {
				tl.fromTo(...tlFadeUp(institution))
					.fromTo(...tlFadeUp(metaElements, { stagger: 0.06 }), TIMELINE_OVERLAP);
				if (arrow) {
					tl.fromTo(arrow, { opacity: 0 }, { opacity: 1, duration: 0.6, ease: "power3.out", clearProps: "transform" }, TIMELINE_OVERLAP);
				}
				tl.fromTo(...tlFadeUp(blocks, { stagger: 0.05 }), TIMELINE_OVERLAP);
			});
		});
	}

	window.addEventListener("intro-complete", () => initEducationAnimations(), { once: true });

	import { groupHoverFade } from "../utils/group-hover";
	groupHoverFade(".edu-card");
</script>

<style>
	.accent-cmu {
		--accent: var(--color-accent-cmu);
	}

	.accent-vit {
		--accent: var(--color-accent-vit);
	}

	.edu-card {
		text-decoration: none;
		transform-origin: left center;
		transition:
			opacity 50ms ease,
			background-color 200ms ease,
			transform 200ms var(--ease-out-expo);
		will-change: transform;
	}

	.edu-institution,
	.edu-card p,
	.edu-card .gpa-pill,
	.edu-honor {
		transition:
			filter 0.15s cubic-bezier(0.16, 1, 0.3, 1),
			color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.edu-arrow {
		transition:
			color 200ms ease,
			transform 200ms var(--ease-out-expo);
	}

	.gpa-pill {
		backdrop-filter: blur(4px);
	}

	@media (hover: hover) and (pointer: fine) {
		.edu-card:hover {
			background: rgba(255, 255, 255, 0.02);
		}

		.edu-card:hover .edu-institution {
			filter: brightness(1.3);
		}

		.edu-card:hover p {
			color: rgba(255, 255, 255, 0.95);
		}

		.edu-card:hover .gpa-pill {
			filter: brightness(1.3);
		}

		.edu-card:hover .edu-honor {
			color: rgba(255, 255, 255, 0.85);
		}

		.edu-card:hover .honor-dot {
			opacity: 1;
		}

		.edu-card:hover .edu-arrow {
			color: var(--accent);
			transform: rotate(45deg);
		}

		.edu-card:active {
			transform: scale(0.98);
			transition: transform 50ms ease;
		}
	}

	.edu-card.flash-highlight {
		animation: cardFlash 1.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes cardFlash {
		0% {
			background: rgba(255, 255, 255, 0.08);
		}
		100% {
			background: transparent;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.edu-card {
			opacity: 1 !important;
			transform: none !important;
			transition: none;
		}

		.edu-card:active {
			transform: none;
		}

		.edu-arrow {
			transition: none;
		}

		.edu-institution,
		.edu-card p,
		.edu-card .gpa-pill,
		.edu-honor {
			transition: none;
		}
	}
</style>
