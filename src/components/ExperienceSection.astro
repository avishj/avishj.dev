---
interface Experience {
  company: string;
  role: string;
  location: string;
  period: string;
  accentColor: string;
  highlights: string[];
  metrics?: string[];
}

const experiences: Experience[] = [
  {
    company: 'Snap Inc.',
    role: 'Software Engineering Intern · Practicum',
    location: 'Pittsburgh, PA',
    period: 'Aug 2025 · Dec 2025',
    accentColor: 'var(--color-accent-snap)',
    highlights: [
      'Architected novel XR remote desktop PoC for Snap Spectacles from scratch (C++, OpenXR, VNC)',
      'Engineered adaptive VNC streaming with tear-free double buffering and adaptive encoding',
      'Implemented hand-tracking with dual-pinch gesture recognition for 6DoF display manipulation',
      'Developed multi-threaded keyboard pipeline supporting physical and virtual input',
    ],
    metrics: ['51.7 FPS', '138ms latency', '97% bandwidth reduction'],
  },
  {
    company: 'Siemens Healthineers',
    role: 'Software Development Engineer Intern',
    location: 'Issaquah, WA',
    period: 'Jun 2025 · Aug 2025',
    accentColor: 'var(--color-accent-siemens)',
    highlights: [
      'Centralized observability for 120+ modules using LLM-powered migration system',
      'Designed custom OpenTelemetry exporters with OTel Collector, Prometheus, Grafana, Loki',
      'Resolved 3.5-year .NET modernization blocker via test framework automation',
      'Recovered lost-source security module via Ghidra reverse engineering',
    ],
    metrics: ['13,000+ loggers migrated', '28,700+ tests', '120+ modules'],
  },
  {
    company: 'Addverb Technologies',
    role: 'Software Engineer · Simulations & Analytics',
    location: 'Delhi NCR, India',
    period: 'Jan 2023 · Jul 2024',
    accentColor: 'var(--color-accent-addverb)',
    highlights: [
      'Developed high-performance SpringBoot middleware replacing OPC for conveyor control',
      'Performed 230+ GTP simulations and data analysis for 4 client solutions',
      'Designed 120-page functional spec with 78 wireframes for end-to-end warehouse solution',
      'Optimized pick face efficiency reducing simulation runtime from 32hrs to 12.5hrs',
    ],
    metrics: ['230+ simulations', '120-page spec', '32hr → 12.5hr'],
  },
  {
    company: 'MITACS · Athabasca University',
    role: 'Graduate Research Intern',
    location: 'Edmonton, Canada',
    period: 'May 2022 · Aug 2022',
    accentColor: 'var(--color-accent-mitacs)',
    highlights: [
      'Created multi-modal learning framework for digital student involvement',
      'Architected responsive dashboard in native JavaScript and Bootstrap',
      'Transformed and integrated 3 deep learning models in live MLOps pipeline via AWS',
    ],
  },
  {
    company: 'Ernst & Young',
    role: 'Technology Consulting Intern',
    location: 'Kolkata, India',
    period: 'Jan 2022 · Apr 2022',
    accentColor: 'var(--color-accent-ey)',
    highlights: [
      'Built ML-based web dashboard with SAP Leonardo for decision-making efficiency',
      'Transformed client operations with insights from 800+ MB of cleaned data',
    ],
  },
  {
    company: 'Tata Steel',
    role: 'Intern · Vocational Trainee',
    location: 'Jamshedpur, India',
    period: 'Jun 2021 · Aug 2021',
    accentColor: 'var(--color-accent-tata)',
    highlights: [
      'Designed responsive dashboard for inventory management using DevExpress',
      'Supported 5 employees via support workflows with C# .NET WinForms',
    ],
  },
];
---

<section id="experience" class="experience-section relative bg-[--color-bg-primary]">
  <div class="mx-auto max-w-(--max-width) px-6 pt-4 pb-20 md:pt-6 md:pb-28 lg:px-12">
    <!-- Section header -->
    <div class="section-header mb-14 flex items-baseline gap-4">
      <span class="text-5xl text-white/50 md:text-6xl" style="font-family: 'Viaoda Libre', serif;">02</span>
      <h2 class="text-5xl italic md:text-6xl" style="font-family: 'Instrument Serif', serif;">Experience</h2>
    </div>

    <!-- Timeline -->
    <div class="experience-timeline relative">
      <!-- Vertical timeline line -->
      <div class="timeline-line absolute top-0 bottom-0 left-0 w-px bg-white/[0.08] md:left-[140px]"></div>

      {experiences.map((exp, index) => (
        <article 
          class="experience-entry group relative pb-12 last:pb-0"
          data-index={index}
          style={`--accent: ${exp.accentColor};`}
        >
          <!-- Timeline dot -->
          <div 
            class="timeline-dot absolute left-0 top-[2px] z-10 h-2 w-2 -translate-x-[3.5px] rounded-full border border-white/20 bg-[--color-bg-primary] transition-all duration-300 group-hover:scale-125 md:left-[140px]"
            style={`border-color: ${exp.accentColor}50;`}
          >
            <div 
              class="absolute inset-0 rounded-full opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style={`background: ${exp.accentColor}; box-shadow: 0 0 8px ${exp.accentColor}60;`}
            ></div>
          </div>

          <div class="grid md:grid-cols-[140px_1fr] md:gap-0">
            <!-- Left: Period (visible on md+) -->
            <div class="hidden pr-8 text-right md:block">
              <span class="font-mono text-xs tracking-wide text-white/35">{exp.period}</span>
            </div>

            <!-- Right: Content -->
            <div class="pl-6 md:pl-8">
              <!-- Company & role row -->
              <div class="mb-3">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 
                    class="entry-title text-lg font-medium tracking-tight"
                    style={`color: ${exp.accentColor};`}
                  >
                    {exp.company}
                  </h3>
                  {exp.metrics && (
                    <div class="flex flex-wrap gap-1.5">
                      {exp.metrics.map((metric) => (
                        <span 
                          class="rounded-md px-2 py-0.5 font-mono text-[10px] font-medium leading-tight"
                          style={`color: ${exp.accentColor}; background: ${exp.accentColor}10; border: 1px solid ${exp.accentColor}20;`}
                        >
                          {metric}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <p class="mt-0.5 text-sm text-white/50">{exp.role}</p>
                <!-- Mobile period + location -->
                <div class="mt-1 flex items-center gap-2 font-mono text-[11px] text-white/30 md:hidden">
                  <span>{exp.period}</span>
                  <span class="h-0.5 w-0.5 rounded-full bg-white/20"></span>
                  <span>{exp.location}</span>
                </div>
                <span class="mt-1 hidden font-mono text-[11px] text-white/30 md:block">{exp.location}</span>
              </div>

              <!-- Highlights as compact list -->
              <ul class="entry-highlights space-y-1.5">
                {exp.highlights.map((highlight) => (
                  <li class="flex gap-2.5 text-[13px] leading-relaxed text-white/60">
                    <span 
                      class="mt-[7px] h-1 w-1 flex-shrink-0 rounded-full"
                      style={`background: ${exp.accentColor}40;`}
                    ></span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const entries = document.querySelectorAll('.experience-entry');
  
  entries.forEach((entry) => {
    const dot = entry.querySelector('.timeline-dot');
    const title = entry.querySelector('.entry-title');
    const highlights = entry.querySelectorAll('.entry-highlights li');

    gsap.set([title, ...entry.querySelectorAll('.entry-title, .entry-title + p, .entry-title ~ span, .entry-title ~ div')].filter(Boolean), { 
      y: 12, 
      opacity: 0 
    });
    gsap.set(highlights, { 
      y: 8, 
      opacity: 0 
    });
    gsap.set(dot, {
      scale: 0,
    });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: entry,
        start: 'top 85%',
        toggleActions: 'play none none reverse',
      },
    });

    tl.to(dot, {
      scale: 1,
      duration: 0.4,
      ease: 'back.out(2)',
    })
    .to(entry.querySelector('.mb-3'), {
      y: 0,
      opacity: 1,
      duration: 0.5,
      ease: 'power3.out',
    }, '-=0.2')
    .to(highlights, {
      y: 0,
      opacity: 1,
      duration: 0.4,
      ease: 'power3.out',
      stagger: 0.04,
    }, '-=0.3');
  });
</script>

<style>
  .experience-entry + .experience-entry {
    border-top: none;
  }

  .experience-entry:hover .timeline-dot {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-dot,
    .entry-title,
    .entry-highlights li {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
