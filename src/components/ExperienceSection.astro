---

<section id="experience" class="experience-section relative bg-[--color-bg-primary] pt-4 pb-16 md:pt-6 md:pb-24">
  <div class="max-w-(--max-width)">
    <!-- Section header — matches About section pattern -->
    <div class="section-header mb-12 flex items-baseline gap-4">
      <span class="text-5xl text-white/50 md:text-6xl" style="font-family: 'Viaoda Libre', serif;">02</span>
      <h2 class="text-5xl italic md:text-6xl" style="font-family: 'Instrument Serif', serif;">Experience</h2>
    </div>

    <!-- Experience list with bullet-based trailing hover -->
    <div class="experience-list">
      {experiences.map((exp, index) => (
        <article 
          class="exp-card group/card border-t border-white/[0.06] py-6 md:py-8"
          data-index={index}
          style={`--accent: ${exp.accentColor};`}
        >
          <div class="grid gap-4 md:grid-cols-12 md:gap-6">
            <!-- Left column: meta -->
            <div class="exp-meta md:col-span-4">
              <h3 
                class="exp-company font-display text-xl font-medium tracking-tight md:text-2xl"
                style={`color: ${exp.accentColor};`}
              >
                {exp.company}
              </h3>
              <p class="mt-1 text-base text-white/60">{exp.role}</p>
              <div class="mt-2 flex items-center gap-2 font-mono text-xs text-white/40">
                <span class="tabular-nums">{exp.period}</span>
                <span class="inline-block h-px w-3 bg-white/25"></span>
                <span>{exp.location}</span>
              </div>

              {exp.metrics && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {exp.metrics.map((metric) => (
                    <span 
                      class="metric-pill rounded-md border px-2.5 py-1 font-mono text-[11px] font-medium leading-none"
                      style={`color: ${exp.accentColor}; background: ${exp.accentColor}08; border-color: ${exp.accentColor}20;`}
                    >
                      {metric}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <!-- Right column: highlights -->
            <div class="md:col-span-8">
              <ul class="exp-highlights space-y-2">
                {exp.highlights.map((highlight) => (
                  <li class="exp-bullet flex gap-3 text-base leading-relaxed text-white/55">
                    <span 
                      class="bullet-dot mt-[7px] h-1 w-1 flex-shrink-0 rounded-full"
                      style={`background: ${exp.accentColor}60;`}
                    ></span>
                    <span class="bullet-text">{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
      <!-- Bottom border -->
      <div class="border-t border-white/[0.06]"></div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll('.exp-card');
  const allBullets = document.querySelectorAll('.exp-bullet');
  
  function initExperienceAnimations() {
    const viewportBottom = window.scrollY + window.innerHeight;
    
    cards.forEach((card) => {
      const company = card.querySelector('.exp-company');
      const meta = card.querySelectorAll('.exp-company ~ p, .exp-company ~ div');
      const highlights = card.querySelectorAll('.exp-highlights li');
      
      const rect = card.getBoundingClientRect();
      const elTop = window.scrollY + rect.top;
      
      // Element is already in/above viewport - show immediately
      if (elTop < viewportBottom) {
        gsap.set(company, { y: 0, opacity: 1 });
        gsap.set(meta, { y: 0, opacity: 1 });
        gsap.set(highlights, { x: 0, opacity: 1 });
      } else {
        // Element is below viewport - set up scroll animation
        gsap.set(company, { y: 15, opacity: 0 });
        gsap.set(meta, { y: 10, opacity: 0 });
        gsap.set(highlights, { x: 12, opacity: 0 });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: card,
            start: 'top 90%',
            once: true,
          },
        });

        tl.to(company, {
          y: 0,
          opacity: 1,
          duration: 0.6,
          ease: 'power4.out',
        })
        .to(meta, {
          y: 0,
          opacity: 1,
          duration: 0.5,
          ease: 'power3.out',
          stagger: 0.06,
        }, '-=0.4')
        .to(highlights, {
          x: 0,
          opacity: 1,
          duration: 0.4,
          ease: 'power3.out',
          stagger: 0.05,
        }, '-=0.3');
      }
    });
    
    ScrollTrigger.refresh();
  }

  // Wait for intro to complete before setting up animations
  window.addEventListener('intro-complete', initExperienceAnimations, { once: true });

  // Trailing hover brightness effect
  const bulletArray = Array.from(allBullets);
  const cardsArray = Array.from(cards) as HTMLElement[];
  const baseOpacity = 0.55;
  const hoverOpacity = 1;
  const trailFalloff = [0.85, 0.7]; // opacity for ±1, ±2 neighbors

  function applyTrailingHover(hoveredIndex: number) {
    bulletArray.forEach((bullet, i) => {
      const distance = Math.abs(i - hoveredIndex);
      let targetOpacity = baseOpacity;
      
      if (distance === 0) {
        targetOpacity = hoverOpacity;
      } else if (distance <= trailFalloff.length) {
        targetOpacity = trailFalloff[distance - 1];
      }

      gsap.to(bullet, {
        color: `rgba(255, 255, 255, ${targetOpacity})`,
        duration: 0.15,
        ease: 'power2.out',
      });

      const dot = bullet.querySelector('.bullet-dot');
      if (dot) {
        gsap.to(dot, {
          opacity: targetOpacity,
          duration: 0.15,
          ease: 'power2.out',
        });
      }
    });

    // Brighten the active card's meta
    const hoveredBullet = bulletArray[hoveredIndex];
    const parentCard = hoveredBullet?.closest('.exp-card') as HTMLElement | null;
    highlightCardMeta(parentCard);
  }

  function highlightCardMeta(activeCard: HTMLElement | null) {
    cardsArray.forEach((card) => {
      const isActive = card === activeCard;
      if (isActive) {
        card.classList.add('meta-active');
      } else {
        card.classList.remove('meta-active');
      }
    });
  }

  function resetHover() {
    bulletArray.forEach((bullet) => {
      gsap.to(bullet, {
        color: `rgba(255, 255, 255, ${baseOpacity})`,
        duration: 0.2,
        ease: 'power2.out',
        overwrite: true,
      });

      const dot = bullet.querySelector('.bullet-dot');
      if (dot) {
        gsap.to(dot, {
          opacity: 0.6,
          duration: 0.2,
          ease: 'power2.out',
          overwrite: true,
        });
      }
    });

    cardsArray.forEach((card) => {
      card.classList.remove('meta-active');
    });
  }

  // Bullet hover listeners
  bulletArray.forEach((bullet, index) => {
    bullet.addEventListener('mouseenter', () => applyTrailingHover(index));
  });

  // Meta (left section) hover listeners - highlight the card
  cardsArray.forEach((card) => {
    const meta = card.querySelector('.exp-meta');
    if (meta) {
      meta.addEventListener('mouseenter', () => highlightCardMeta(card));
    }
  });

  const experienceList = document.querySelector('.experience-list');
  experienceList?.addEventListener('mouseleave', resetHover);
</script>

<style>
  .exp-card {
    transform-origin: left center;
  }

  .exp-card.meta-active .exp-company {
    filter: brightness(1.4);
  }

  .exp-card.meta-active .exp-meta p,
  .exp-card.meta-active .exp-meta > div:not(.mt-3) {
    color: rgba(255, 255, 255, 0.85);
  }

  .exp-card.meta-active .metric-pill {
    filter: brightness(1.3);
  }

  .exp-company,
  .exp-meta p,
  .exp-meta > div,
  .metric-pill {
    transition: filter 0.15s cubic-bezier(0.16, 1, 0.3, 1), 
                color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .metric-pill {
    backdrop-filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-card {
      opacity: 1 !important;
      transform: none !important;
    }
    .exp-highlights li {
      opacity: 1 !important;
      transform: none !important;
    }
    .exp-meta {
      transition: none;
    }
  }

  .exp-card.flash-highlight {
    animation: cardFlash 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cardFlash {
    0% {
      background: rgba(255, 255, 255, 0.08);
    }
    100% {
      background: transparent;
    }
  }
</style>
