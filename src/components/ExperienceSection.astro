---
// Experience Section with section-based accent colors and sticky assembly animations
// Inspired by Shopify Editions + destroytoday.com

interface Experience {
  company: string;
  role: string;
  location: string;
  period: string;
  accentColor: string;
  highlights: string[];
  metrics?: string[];
}

const experiences: Experience[] = [
  {
    company: 'Snap Inc.',
    role: 'Software Engineering Intern · Practicum',
    location: 'Pittsburgh, PA',
    period: 'Aug 2025 · Dec 2025',
    accentColor: 'var(--color-accent-snap)',
    highlights: [
      'Architected novel XR remote desktop PoC for Snap Spectacles from scratch (C++, OpenXR, VNC)',
      'Engineered adaptive VNC streaming with tear-free double buffering and adaptive encoding',
      'Implemented hand-tracking with dual-pinch gesture recognition for 6DoF display manipulation',
      'Developed multi-threaded keyboard pipeline supporting physical and virtual input',
    ],
    metrics: ['51.7 FPS', '138ms latency', '97% bandwidth reduction'],
  },
  {
    company: 'Siemens Healthineers',
    role: 'Software Development Engineer Intern',
    location: 'Issaquah, WA',
    period: 'Jun 2025 · Aug 2025',
    accentColor: 'var(--color-accent-siemens)',
    highlights: [
      'Centralized observability for 120+ modules using LLM-powered migration system',
      'Designed custom OpenTelemetry exporters with OTel Collector, Prometheus, Grafana, Loki',
      'Resolved 3.5-year .NET modernization blocker via test framework automation',
      'Recovered lost-source security module via Ghidra reverse engineering',
    ],
    metrics: ['13,000+ loggers migrated', '28,700+ tests', '120+ modules'],
  },
  {
    company: 'Addverb Technologies',
    role: 'Software Engineer · Simulations & Analytics',
    location: 'Delhi NCR, India',
    period: 'Jan 2023 · Jul 2024',
    accentColor: 'var(--color-accent-addverb)',
    highlights: [
      'Developed high-performance SpringBoot middleware replacing OPC for conveyor control',
      'Performed 230+ GTP simulations and data analysis for 4 client solutions',
      'Designed 120-page functional spec with 78 wireframes for end-to-end warehouse solution',
      'Optimized pick face efficiency reducing simulation runtime from 32hrs to 12.5hrs',
    ],
    metrics: ['230+ simulations', '120-page spec', '32hr → 12.5hr'],
  },
  {
    company: 'MITACS · Athabasca University',
    role: 'Graduate Research Intern',
    location: 'Edmonton, Canada',
    period: 'May 2022 · Aug 2022',
    accentColor: 'var(--color-accent-mitacs)',
    highlights: [
      'Created multi-modal learning framework for digital student involvement',
      'Architected responsive dashboard in native JavaScript and Bootstrap',
      'Transformed and integrated 3 deep learning models in live MLOps pipeline via AWS',
    ],
  },
  {
    company: 'Ernst & Young',
    role: 'Technology Consulting Intern',
    location: 'Kolkata, India',
    period: 'Jan 2022 · Apr 2022',
    accentColor: 'var(--color-accent-ey)',
    highlights: [
      'Built ML-based web dashboard with SAP Leonardo for decision-making efficiency',
      'Transformed client operations with insights from 800+ MB of cleaned data',
    ],
  },
  {
    company: 'Tata Steel',
    role: 'Intern · Vocational Trainee',
    location: 'Jamshedpur, India',
    period: 'Jun 2021 · Aug 2021',
    accentColor: 'var(--color-accent-tata)',
    highlights: [
      'Designed responsive dashboard for inventory management using DevExpress',
      'Supported 5 employees via support workflows with C# .NET WinForms',
    ],
  },
];
---

<section id="experience" class="experience-section relative bg-[--color-bg-primary]">
  <!-- Section header with massive typography -->
  <div class="flex min-h-[60vh] items-center bg-[--color-bg-primary] py-24">
    <div class="max-w-[--max-width]">
      <div class="flex items-end justify-between">
        <div>
          <span class="experience-label block font-mono text-sm uppercase tracking-[0.3em] text-[--color-text-muted]">02 · Experience</span>
          <h2 class="experience-title mt-4 font-display text-6xl font-medium tracking-tight md:text-7xl lg:text-8xl">
            Where I've<br/>
            <span class="text-gradient bg-gradient-to-r from-white via-white/80 to-white/40 bg-clip-text text-transparent">Built Things</span>
          </h2>
        </div>
        <div class="hidden text-right md:block">
          <span class="font-mono text-[8rem] font-bold leading-none text-white/[0.03]">06</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Experience cards - regular flow, no sticky overlap -->
  <div class="experience-track relative">
    {experiences.map((exp, index) => (
      <article 
        class="experience-card relative flex items-center py-24"
        data-index={index}
        style={`--accent: ${exp.accentColor}; --card-index: ${index};`}
      >
        <!-- Full-screen accent background glow -->
        <div 
          class="accent-glow pointer-events-none absolute inset-0 opacity-0"
          style={`background: radial-gradient(ellipse 80% 50% at 50% 100%, ${exp.accentColor}15 0%, transparent 50%);`}
        ></div>

        <div class="mx-auto w-full max-w-[--max-width] px-6">
          <div class="grid gap-8 md:grid-cols-12 md:gap-12">
            <!-- Left: Company info -->
            <div class="md:col-span-5">
              <!-- Large index number -->
              <span 
                class="card-index block font-display text-[6rem] font-bold leading-none md:text-[8rem]"
                style={`color: ${exp.accentColor}20;`}
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              
              <h3 
                class="card-title -mt-8 font-display text-3xl font-medium tracking-tight md:-mt-12 md:text-4xl lg:text-5xl"
                style={`color: ${exp.accentColor};`}
              >
                {exp.company}
              </h3>
              <p class="card-role mt-2 text-lg text-white/70">{exp.role}</p>
              
              <div class="card-meta mt-6 flex items-center gap-4 font-mono text-sm text-[--color-text-muted]">
                <span class="tabular-nums">{exp.period}</span>
                <span class="h-1 w-1 rounded-full bg-white/30"></span>
                <span>{exp.location}</span>
              </div>

              <!-- Metrics with animated counters -->
              {exp.metrics && (
                <div class="card-metrics mt-8 flex flex-wrap gap-3">
                  {exp.metrics.map((metric) => (
                    <div 
                      class="metric-pill rounded-xl border px-4 py-2"
                      style={`border-color: ${exp.accentColor}30; background: ${exp.accentColor}08;`}
                    >
                      <span class="font-mono text-lg font-medium" style={`color: ${exp.accentColor};`}>{metric}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- Right: Highlights -->
            <div class="md:col-span-7">
              <ul class="card-highlights space-y-4">
                {exp.highlights.map((highlight, i) => (
                  <li 
                    class="highlight-item flex gap-4 rounded-xl border border-white/[0.04] bg-white/[0.02] p-4 backdrop-blur-sm transition-all duration-300 hover:border-white/[0.08] hover:bg-white/[0.04]"
                    style={`--highlight-delay: ${i * 100}ms;`}
                  >
                    <span 
                      class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full"
                      style={`background: ${exp.accentColor};`}
                    ></span>
                    <span class="text-base leading-relaxed text-white/80">{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </article>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ═══════════════════════════════════════════════════════════════════════════
  // SECTION HEADER ANIMATION
  // ═══════════════════════════════════════════════════════════════════════════
  gsap.fromTo('.experience-label', 
    { x: -30, opacity: 0 },
    {
      x: 0,
      opacity: 1,
      duration: 0.8,
      ease: 'power4.out',
      scrollTrigger: {
        trigger: '.experience-section',
        start: 'top 60%',
      },
    }
  );

  gsap.fromTo('.experience-title',
    { y: 50, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: 'power4.out',
      scrollTrigger: {
        trigger: '.experience-section',
        start: 'top 60%',
      },
      delay: 0.2,
    }
  );

  // ═══════════════════════════════════════════════════════════════════════════
  // STICKY CARD SCROLL — Each card pins and reveals content
  // ═══════════════════════════════════════════════════════════════════════════
  const cards = document.querySelectorAll('.experience-card');
  
  cards.forEach((card, index) => {
    const cardEl = card as HTMLElement;
    const accentGlow = card.querySelector('.accent-glow');
    const cardIndex = card.querySelector('.card-index');
    const cardTitle = card.querySelector('.card-title');
    const cardRole = card.querySelector('.card-role');
    const cardMeta = card.querySelector('.card-meta');
    const cardMetrics = card.querySelector('.card-metrics');
    const highlights = card.querySelectorAll('.highlight-item');

    // Initial state
    gsap.set([cardIndex, cardTitle, cardRole, cardMeta, cardMetrics], { 
      y: 40, 
      opacity: 0 
    });
    gsap.set(highlights, { 
      x: 30, 
      opacity: 0 
    });

    // Card scroll trigger
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: card,
        start: 'top 80%',
        end: 'top 20%',
        scrub: false,
        toggleActions: 'play none none reverse',
      },
    });

    tl.to(accentGlow, {
      opacity: 1,
      duration: 0.6,
      ease: 'power2.out',
    })
    .to(cardIndex, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'power4.out',
    }, '-=0.4')
    .to(cardTitle, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'power4.out',
    }, '-=0.5')
    .to(cardRole, {
      y: 0,
      opacity: 1,
      duration: 0.5,
      ease: 'power3.out',
    }, '-=0.4')
    .to(cardMeta, {
      y: 0,
      opacity: 1,
      duration: 0.5,
      ease: 'power3.out',
    }, '-=0.4')
    .to(cardMetrics, {
      y: 0,
      opacity: 1,
      duration: 0.5,
      ease: 'power3.out',
    }, '-=0.3')
    .to(highlights, {
      x: 0,
      opacity: 1,
      duration: 0.5,
      ease: 'power3.out',
      stagger: 0.08,
    }, '-=0.4');
  });

  // ═══════════════════════════════════════════════════════════════════════════
  // HIGHLIGHT HOVER MICRO-INTERACTION
  // ═══════════════════════════════════════════════════════════════════════════
  const highlightItems = document.querySelectorAll('.highlight-item');
  
  highlightItems.forEach((item) => {
    item.addEventListener('mouseenter', () => {
      gsap.to(item, {
        scale: 1.02,
        duration: 0.3,
        ease: 'power2.out',
      });
    });
    
    item.addEventListener('mouseleave', () => {
      gsap.to(item, {
        scale: 1,
        duration: 0.3,
        ease: 'power2.out',
      });
    });
  });
</script>

<style>
  .experience-card {
    background: transparent;
  }

  .text-gradient {
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .metric-pill {
    backdrop-filter: blur(8px);
  }

  .highlight-item {
    transform-origin: left center;
  }

  /* Divider between cards */
  .experience-card + .experience-card {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight-item {
      transition: none;
    }
  }
</style>
