---
// Floating contact bar - fixed pill at bottom with glassmorphism
const socialLinks = [
  { href: 'mailto:avishj@cs.cmu.edu', label: 'Email', icon: 'mail' },
  { href: 'https://linkedin.com/in/avishj', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://github.com/avishj', label: 'GitHub', icon: 'github' },
  { href: 'https://scholar.google.com/citations?user=5tb4VWYAAAAJ', label: 'Scholar', icon: 'scholar' },
];
---

<div class="floating-contact fixed bottom-6 left-1/2 z-50 -translate-x-1/2">
  <div class="glass flex items-center gap-1 rounded-2xl border border-white/10 px-2 py-2 shadow-lg">
    {socialLinks.map((link) => (
      <a
        href={link.href}
        target={link.href.startsWith('mailto') ? undefined : '_blank'}
        rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
        aria-label={link.label}
        class="contact-icon group flex h-10 w-10 items-center justify-center rounded-xl text-[--color-text-muted] transition-all duration-150 active:scale-90"
      >
        {link.icon === 'mail' && (
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        )}
        {link.icon === 'linkedin' && (
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        )}
        {link.icon === 'github' && (
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        )}
        {link.icon === 'scholar' && (
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
          </svg>
        )}
      </a>
    ))}
    
    <!-- Divider -->
    <div class="mx-1 h-6 w-px bg-white/10"></div>
    
    <!-- Status indicator -->
    <div class="flex items-center gap-2 px-3">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
      </span>
      <span class="text-xs text-[--color-text-muted]">Available</span>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';

  const floatingContact = document.querySelector('.floating-contact') as HTMLElement;
  
  if (floatingContact) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    // Set initial hidden state
    gsap.set(floatingContact, { y: 20, opacity: 0 });
    
    let isVisible = false;
    
    // Show after scrolling past the header
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting && !isVisible) {
          isVisible = true;
          gsap.to(floatingContact, {
            y: 0,
            opacity: 1,
            duration: prefersReducedMotion ? 0 : 0.4,
            ease: 'power3.out',
          });
        } else if (entry.isIntersecting && isVisible) {
          isVisible = false;
          gsap.to(floatingContact, {
            y: 10,
            opacity: 0,
            duration: prefersReducedMotion ? 0 : 0.3,
            ease: 'power2.in',
          });
        }
      },
      { threshold: 0.5 }
    );

    // Observe the header
    const header = document.querySelector('header');
    if (header) observer.observe(header);
  }
</script>

<style>
  .floating-contact {
    will-change: transform, opacity;
  }

  /* Touch device protection - only apply hover on devices with pointer */
  @media (hover: hover) and (pointer: fine) {
    .contact-icon:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
    }
  }
</style>
