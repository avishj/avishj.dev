---
const yearDisplay = `2021–${new Date().getFullYear()}`;
---

<footer class="py-12">
	<div class="border-t border-white/[0.06] pt-8">
		<div class="flex flex-col items-center justify-between gap-3 md:flex-row">
			<p class="font-mono text-sm text-[--color-text-muted]">© {yearDisplay} Avish Jha</p>
			<p class="font-mono text-sm text-[--color-text-muted]">
				designed with intent &
				<span class="inline-flex items-center align-middle relative -top-px">
					<svg class="footer-heart h-4 w-4 text-[#e25555] will-change-transform" viewBox="0 0 24 24" fill="currentColor" aria-label="love">
						<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
					</svg>
				</span>
			</p>
		</div>
	</div>
</footer>

<style>
	.footer-heart {
		animation: heartbeat 1.8s ease-in-out infinite;
	}

	@keyframes heartbeat {
		0%,
		100% {
			transform: scale(1);
		}
		14% {
			transform: scale(1.2);
		}
		28% {
			transform: scale(1);
		}
		42% {
			transform: scale(1.15);
		}
		56% {
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-heart {
			animation: none;
		}
	}
</style>
