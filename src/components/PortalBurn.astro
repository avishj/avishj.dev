---
// Portal Burn Effect Component
// Shader-based dissolve transition inspired by Shopify Editions
// Uses FBM noise for organic chaotic edges, no particle system
---

<canvas id="portal-canvas" class="pointer-events-none fixed inset-0 z-[100] hidden"></canvas>

<script>
import * as THREE from 'three';

// Noise functions for organic dissolve
const noiseGLSL = `
float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
  float value = 0.0;
  float amplitude = 0.5;
  float frequency = 1.0;
  
  for (int i = 0; i < 5; i++) {
    value += amplitude * noise(p * frequency);
    amplitude *= 0.5;
    frequency *= 2.0;
  }
  return value;
}
`;

export function initPortalBurn(
  originX: number, 
  originY: number, 
  onComplete: () => void
) {
  const canvas = document.getElementById('portal-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  
  canvas.classList.remove('hidden');
  
  const W = window.innerWidth;
  const H = window.innerHeight;
  
  // Normalize origin to 0-1 UV range
  const centerX = originX / W;
  const centerY = 1.0 - (originY / H); // Flip Y for WebGL
  
  // Setup Three.js
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);
  
  const scene = new THREE.Scene();
  const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
  camera.position.z = 1;
  
  const aspect = W / H;
  
  // Calculate max distance from origin to any corner (for full coverage)
  const corners = [
    [0, 0], [1, 0], [0, 1], [1, 1]
  ];
  let maxDist = 0;
  for (const [cx, cy] of corners) {
    const dx = (cx - centerX) * aspect;
    const dy = cy - centerY;
    const d = Math.sqrt(dx * dx + dy * dy);
    if (d > maxDist) maxDist = d;
  }
  // Add extra margin for noise distortion
  maxDist *= 1.4;
  
  const uniforms = {
    uDissolve: { value: 0.0 },
    uCenter: { value: new THREE.Vector2(centerX, centerY) },
    uResolution: { value: new THREE.Vector2(W, H) },
    uMaxDist: { value: maxDist },
    uEdgeColor: { value: new THREE.Color(1.0, 0.7, 0.3) }, // Warm golden
  };
  
  const geometry = new THREE.PlaneGeometry(2, 2);
  const material = new THREE.ShaderMaterial({
    uniforms,
    transparent: true,
    vertexShader: `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: `
      ${noiseGLSL}
      
      uniform float uDissolve;
      uniform vec2 uCenter;
      uniform vec2 uResolution;
      uniform float uMaxDist;
      uniform vec3 uEdgeColor;
      
      varying vec2 vUv;
      
      void main() {
        // Aspect-corrected coordinates
        float aspect = uResolution.x / uResolution.y;
        vec2 centeredUv = vUv - uCenter;
        centeredUv.x *= aspect;
        
        float dist = length(centeredUv);
        
        // Angular position for directional noise
        float angle = atan(centeredUv.y, centeredUv.x);
        
        // Pixelated/block noise - tiny particles
        float noiseScale = 1.5;
        vec2 pixelatedUv = floor(vUv * uResolution / noiseScale) * noiseScale / uResolution;
        float blockNoise = fbm(pixelatedUv * 180.0) * 0.3;
        
        // Angular noise for jagged edge - extreme variance
        float angularNoise = fbm(vec2(angle * 8.0, dist * 6.0)) * 0.45;
        
        // Radial streaks - strong directional bias for streak effect
        float radialNoise = fbm(vec2(angle * 20.0, 0.0)) * 0.4;
        
        // Secondary streaks at different frequency
        float streakNoise = fbm(vec2(angle * 35.0, dist * 2.0)) * 0.25;
        
        // Fine ember dust
        float fineNoise = fbm(vUv * 300.0) * 0.1;
        
        // Combine noises for chaotic streaky distortion
        float totalNoise = blockNoise + angularNoise + radialNoise + streakNoise + fineNoise;
        float noisyDist = dist + totalNoise;
        
        // Normalize to 0-1 range
        float normalizedDist = noisyDist / uMaxDist;
        
        // Dissolve threshold based on progress
        float dissolveThreshold = uDissolve;
        
        // Sharp dissolve mask
        float dissolveMask = smoothstep(dissolveThreshold - 0.02, dissolveThreshold, normalizedDist);
        
        // Inside the hole = fully transparent
        if (dissolveMask < 0.01) {
          discard;
        }
        
        // Edge glow zone
        float edgeZoneWidth = 0.12 * (1.0 - uDissolve) + 0.03;
        float edgeZone = smoothstep(dissolveThreshold - edgeZoneWidth, dissolveThreshold - edgeZoneWidth + 0.04, normalizedDist) *
                         smoothstep(dissolveThreshold + 0.03, dissolveThreshold - 0.01, normalizedDist);
        
        // Ember particles - tiny hot specks
        float ember = hash(floor(vUv * uResolution / 1.0)) * edgeZone;
        ember = pow(ember, 2.2) * 1.8;
        
        // Scattered bright embers
        float scatter = hash(floor(vUv * uResolution / 1.8));
        scatter = step(0.85, scatter) * edgeZone * 2.0;
        
        // Base color (dark background)
        vec3 bgColor = vec3(0.03, 0.02, 0.02);
        
        // Ember color gradient: white hot core -> orange -> deep red at edges
        float emberTemp = ember + scatter * 0.5;
        vec3 hotCore = vec3(1.0, 0.95, 0.8);    // White-yellow
        vec3 midFlame = vec3(1.0, 0.5, 0.1);    // Orange
        vec3 coolEdge = vec3(0.8, 0.2, 0.05);   // Deep red-orange
        
        // Temperature-based color mixing
        vec3 emberColor = mix(coolEdge, midFlame, smoothstep(0.0, 0.5, emberTemp));
        emberColor = mix(emberColor, hotCore, smoothstep(0.5, 1.0, emberTemp));
        
        // Edge glow - warmer orange tones
        float glowIntensity = edgeZone * 1.2;
        vec3 glow = mix(vec3(0.9, 0.3, 0.05), vec3(1.0, 0.6, 0.2), edgeZone) * glowIntensity;
        
        // Combine ember particles
        vec3 emberParticles = emberColor * (ember + scatter);
        
        // Final color
        vec3 finalColor = bgColor + glow + emberParticles;
        
        // Alpha: solid background fading at very edge
        float alpha = dissolveMask;
        
        gl_FragColor = vec4(finalColor, alpha);
      }
    `,
  });
  
  const mesh = new THREE.Mesh(geometry, material);
  scene.add(mesh);
  
  // Animation - slower for more dramatic effect
  const duration = 3800;
  const startTime = performance.now();
  
  function animate() {
    const elapsed = performance.now() - startTime;
    const progress = Math.min(elapsed / duration, 1);
    
    // Aggressive ease-out curve
    const easedProgress = 1 - Math.pow(1 - progress, 3);
    
    uniforms.uDissolve.value = easedProgress;
    
    renderer.render(scene, camera);
    
    if (progress < 1) {
      requestAnimationFrame(animate);
    } else {
      // Cleanup
      renderer.dispose();
      geometry.dispose();
      material.dispose();
      canvas.classList.add('hidden');
      onComplete();
    }
  }
  
  requestAnimationFrame(animate);
}

// Export to window for access from index.astro
(window as any).initPortalBurn = initPortalBurn;
</script>
