---
// Projects Bento Grid with group hover opacity fade
// Inspired by pqoqubbw.dev + Shopify Editions card patterns

interface Project {
  title: string;
  description: string;
  tech: string[];
  link?: string;
  size: 'large' | 'medium' | 'small';
}

const projects: Project[] = [
  {
    title: 'XR Remote Desktop',
    description: 'Novel remote desktop streaming for Snap Spectacles AR glasses. Real-time desktop mirroring with hand-tracking interaction in 3D space.',
    tech: ['C++', 'OpenXR', 'LibVNC'],
    size: 'large',
  },
  {
    title: 'LLM Log Migration',
    description: 'Automated migration of 13,000+ legacy loggers to OpenTelemetry using Claude agents and AST parsing.',
    tech: ['C#', 'Python', 'Claude API'],
    size: 'medium',
  },
  {
    title: 'MFC Recruitment Portal',
    description: 'Frontend for candidate tests across 5 domains, handling 1200+ applicants with 100+ concurrent tests.',
    tech: ['VueJS', 'Axios', 'Cloudflare'],
    link: 'https://github.com/MFC-VIT/MFC-RecruitmentPortal-Frontend',
    size: 'medium',
  },
  {
    title: 'SEDS India',
    description: 'Unified 4 portals, managed 7 websites, 180+ emails, and 3+ domains. Reduced OpEx by 40%.',
    tech: ['JavaScript', 'jQuery', 'Netlify'],
    link: 'https://github.com/sedsindia/sedsindia.github.io',
    size: 'small',
  },
  {
    title: 'Warehouse Simulation Engine',
    description: 'GTP simulation and order orchestration system. Optimized pick face efficiency from 32hr to 12.5hr runtime.',
    tech: ['Java', 'SpringBoot', 'Analytics'],
    size: 'small',
  },
  {
    title: 'Multi-Modal Learning Framework',
    description: 'Student engagement tracking with 3 deep learning models in AWS MLOps pipeline.',
    tech: ['Python', 'TensorFlow', 'AWS'],
    size: 'small',
  },
];

// Determine grid classes based on size
const sizeClasses = {
  large: 'md:col-span-2 md:row-span-2',
  medium: 'md:col-span-1 md:row-span-2',
  small: 'md:col-span-1 md:row-span-1',
};
---

<section id="projects" class="projects-section relative bg-[--color-bg-primary] pt-4 pb-16 text-[--color-text-primary] md:pt-6 md:pb-24">
  <!-- Section header -->
  <div class="max-w-(--max-width)">
    <div class="section-header mb-12 flex items-baseline gap-4">
      <span class="text-5xl text-white/50 md:text-6xl" style="font-family: 'Viaoda Libre', serif;">03</span>
      <h2 class="text-5xl italic text-white md:text-6xl" style="font-family: 'Instrument Serif', serif;">Projects</h2>
    </div>
  </div>

  <!-- Bento Grid -->
  <div class="bento-grid group mx-auto grid max-w-(--max-width) gap-4 px-6 md:grid-cols-3 md:gap-6">
    {projects.map((project, index) => (
      <article 
        class={`project-card relative overflow-hidden rounded-2xl border border-black/[0.08] bg-white p-6 transition-all duration-200 ${sizeClasses[project.size]}`}
        data-index={index}
      >
        <!-- Gradient fade overlay at bottom -->
        <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent"></div>

        <!-- Content -->
        <div class="relative flex h-full flex-col">
          <!-- Title with external link -->
          <div class="mb-3 flex items-start justify-between gap-2">
            <h3 class="font-display text-xl font-medium tracking-tight md:text-2xl">
              {project.title}
            </h3>
            {project.link && (
              <a 
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link-icon flex-shrink-0 text-black/40 transition-colors duration-200"
                aria-label={`View ${project.title} on GitHub`}
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                </svg>
              </a>
            )}
          </div>

          <!-- Description -->
          <p class="mb-4 flex-grow text-sm leading-relaxed text-black/60">
            {project.description}
          </p>

          <!-- Tech stack pills -->
          <div class="mt-auto flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <span class="rounded-full bg-black/5 px-3 py-1 font-mono text-xs text-black/70">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Corner decoration for large cards -->
        {project.size === 'large' && (
          <div class="pointer-events-none absolute right-4 top-4 opacity-5">
            <svg class="h-24 w-24" viewBox="0 0 100 100" fill="currentColor">
              <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="1" fill="none" />
              <circle cx="50" cy="50" r="30" stroke="currentColor" stroke-width="1" fill="none" />
              <circle cx="50" cy="50" r="15" stroke="currentColor" stroke-width="1" fill="none" />
            </svg>
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<script>
  async function initProjectAnimations() {
    const { scrollReveal, presets } = await import('../utils/scroll-animations');
    const cards = document.querySelectorAll('.project-card');
    scrollReveal(cards, presets.fadeUpScale);
  }

  // Wait for intro to complete before setting up animations
  window.addEventListener('intro-complete', () => initProjectAnimations(), { once: true });

  // Group hover opacity fade effect (pqoqubbw style)
  const grid = document.querySelector('.bento-grid');
  const projectCards = document.querySelectorAll('.project-card');
  
  if (grid) {
    projectCards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        projectCards.forEach((otherCard) => {
          if (otherCard !== card) {
            (otherCard as HTMLElement).style.opacity = '0.4';
          }
        });
      });
      
      card.addEventListener('mouseleave', () => {
        projectCards.forEach((otherCard) => {
          (otherCard as HTMLElement).style.opacity = '1';
        });
      });
    });
  }
</script>

<style>
  .project-card {
    transition: opacity 50ms ease, transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  /* Touch device protection - only apply hover on devices with pointer */
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      border-color: rgba(0, 0, 0, 0.2);
      box-shadow: 0 13px 27px -5px rgba(50, 50, 93, 0.25), 0 8px 16px -8px rgba(0, 0, 0, 0.3);
    }

    .project-link-icon:hover {
      color: black;
    }
  }
</style>
