---
const redirectEnabled = import.meta.env.PUBLIC_CMU_REDIRECT === 'true';
---

{redirectEnabled && (
	<div id="redirect-overlay" class="fixed inset-0 z-[100] flex items-center justify-center p-6" style="display:none;">
		<!-- Backdrop -->
		<div class="redirect-backdrop absolute inset-0 bg-black/70 backdrop-blur-md"></div>

		<!-- Modal -->
		<div class="redirect-modal glass relative max-w-md w-full rounded-2xl border border-white/[0.08] p-8 shadow-lg">
			<!-- CMU accent bar -->
			<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-(--color-accent-cmu) to-transparent"></div>

			<p class="font-mono text-xs tracking-[0.2em] uppercase text-white/40 mb-4">Notice</p>

			<h2 class="font-display text-2xl text-white mb-3">This page has moved</h2>

			<p class="text-sm text-white/70 leading-relaxed mb-6">
				I've graduated from CMU, so this site may be outdated.
				You'll be redirected to my current website in
				<span id="redirect-countdown" class="font-mono text-white tabular-nums">10</span>s.
			</p>

			<!-- Progress bar -->
			<div class="h-px w-full bg-white/10 rounded-full mb-6 overflow-hidden">
				<div id="redirect-progress" class="h-full bg-(--color-accent-cmu) rounded-full" style="width:0%"></div>
			</div>

			<div class="flex items-center gap-3">
				<button id="redirect-stay" class="flex-1 rounded-lg border border-white/[0.12] px-4 py-2.5 font-mono text-sm text-white/80 transition-colors duration-150 ease hover:border-white/25 hover:text-white active:scale-[0.97]">
					Stay here
				</button>
				<a id="redirect-go" href="https://avishj.github.io/avishj.dev" class="flex-1 rounded-lg bg-(--color-accent-cmu) px-4 py-2.5 text-center font-mono text-sm text-black font-medium transition-opacity duration-150 ease hover:opacity-90 active:scale-[0.97]">
					Go now
				</a>
			</div>
		</div>
	</div>

	<script>
		import { gsap } from "../utils/gsap-init";
		import { onIntroComplete } from "../utils/intro-event";

		function initRedirect() {
			const overlay = document.getElementById("redirect-overlay");
			const modal = overlay?.querySelector(".redirect-modal");
			const backdrop = overlay?.querySelector(".redirect-backdrop");
			const countdown = document.getElementById("redirect-countdown");
			const progress = document.getElementById("redirect-progress");
			const stayBtn = document.getElementById("redirect-stay");

			if (!overlay || !modal || !backdrop || !countdown || !progress) return;

			const el = { overlay, modal, backdrop };

			overlay.style.display = "flex";

			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (prefersReducedMotion) {
				gsap.set(backdrop, { opacity: 1 });
				gsap.set(modal, { opacity: 1, y: 0, scale: 1 });
			} else {
				gsap.set(backdrop, { opacity: 0 });
				gsap.set(modal, { opacity: 0, y: 24, scale: 0.96 });

				gsap.to(backdrop, { opacity: 1, duration: 0.35, ease: "power2.out" });
				gsap.to(modal, {
					opacity: 1,
					y: 0,
					scale: 1,
					duration: 0.45,
					ease: "power4.out",
					delay: 0.1
				});
			}

			let remaining = 10;
			const total = 10;

			const timer = setInterval(() => {
				remaining--;
				countdown.textContent = String(remaining);
				gsap.to(progress, {
					width: `${((total - remaining) / total) * 100}%`,
					duration: 0.8,
					ease: "power2.out"
				});

				if (remaining <= 0) {
					clearInterval(timer);
					window.location.href = "https://avishj.github.io/avishj.dev";
				}
			}, 1000);

			function dismiss() {
				clearInterval(timer);
				if (prefersReducedMotion) {
					el.overlay.remove();
					return;
				}
				gsap.to(el.modal, {
					opacity: 0,
					y: -16,
					scale: 0.97,
					duration: 0.25,
					ease: "power3.in"
				});
				gsap.to(el.backdrop, {
					opacity: 0,
					duration: 0.3,
					delay: 0.05,
					onComplete: () => el.overlay.remove()
				});
			}

			stayBtn?.addEventListener("click", dismiss);
		}

		onIntroComplete(() => initRedirect());
	</script>
)}
