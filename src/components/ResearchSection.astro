---
interface Publication {
  title: string;
  authors: string[];
  highlightAuthor: string;
  venue: string;
  venueType: 'IEEE' | 'Springer' | 'Preprint';
  year: number;
  citations: number;
  doi?: string;
  link: string;
  status: 'published' | 'accepted' | 'preprint';
  isFirstAuthor?: boolean;
}

interface AcademicService {
  role: string;
  conference: string;
  abbreviation: string;
  organizers: string[];
  year: number;
  location: string;
  dates: string;
  details: string;
  invitedBy?: string;
}

const publications: Publication[] = [
  {
    title: 'Addressing Background Genomic and Environmental Effects on Health through Accelerated Computing and Machine Learning: Results from the 2025 Hackathon at Carnegie Mellon University',
    authors: ['S Sabata', 'J Kubica', 'R Gupta', 'LW Ericson', 'HC Atanda', 'G Subramaniam', 'AG Moller', 'RO Abolade', 'A Banka', 'S Blechman', 'R Brenner', 'M Chikina', 'LC Chong', 'NP Cooley', 'D Chang', 'P Greer', 'A Gupta', 'A Jha', 'E Kacar', 'N Kubota', 'W Lu', 'L Luo', 'T Ly', 'R Mondal', "C O'Donoghue", 'AM Phyo', 'P Qiu', 'G Ross-Dolan', 'A Saadat', 'S Sadasivan', 'R Satterwhite', 'S Shirolkar', 'Y Zheng', 'H Wang', 'M Gainey', 'B Busby'],
    highlightAuthor: 'A Jha',
    venue: 'CMU-DNAnexus Hackathon',
    venueType: 'Preprint',
    year: 2025,
    citations: 1,
    doi: 'https://doi.org/10.37044/osf.io/3a8cn_v1',
    link: 'https://doi.org/10.37044/osf.io/3a8cn_v1',
    status: 'preprint',
    isFirstAuthor: false,
  },
  {
    title: 'Harnessing Creative Methods for EEG Feature Extraction and Modeling in Neurological Disorder Diagnoses',
    authors: ['A Jha', 'N Kuruvilla', 'P Garg', 'A Victor'],
    highlightAuthor: 'A Jha',
    venue: '7th CSITSS',
    venueType: 'IEEE',
    year: 2023,
    citations: 7,
    doi: 'https://doi.org/10.1109/CSITSS60515.2023.10334244',
    link: 'https://doi.org/10.1109/CSITSS60515.2023.10334244',
    status: 'published',
    isFirstAuthor: true,
  },
  {
    title: 'Enhancing Visibility: Multiresolution Dark Channel Prior for Dehazing and Fog Removal in Images',
    authors: ['P Garg', 'A Jha', 'SK Jindal'],
    highlightAuthor: 'A Jha',
    venue: '7th CSITSS',
    venueType: 'IEEE',
    year: 2023,
    citations: 2,
    doi: 'https://doi.org/10.1109/CSITSS60515.2023.10334128',
    link: 'https://doi.org/10.1109/CSITSS60515.2023.10334128',
    status: 'published',
    isFirstAuthor: false,
  },
  {
    title: 'Randomised Analysis of Backtracking-based Search Algorithms in Elucidating Sudoku Puzzles Using a Dual Serial/Parallel Approach',
    authors: ['P Garg', 'A Jha', 'A Shukla'],
    highlightAuthor: 'A Jha',
    venue: '4th ICICIT · LNNS vol. 336',
    venueType: 'Springer',
    year: 2022,
    citations: 2,
    doi: 'https://link.springer.com/chapter/10.1007/978-981-16-6723-7_21',
    link: 'https://link.springer.com/chapter/10.1007/978-981-16-6723-7_21',
    status: 'published',
    isFirstAuthor: false,
  },
  {
    title: 'Automated Detection Of Driving Pathway Using Image Processing',
    authors: ['P Priyadarshini', 'A Jha', 'M Raj'],
    highlightAuthor: 'A Jha',
    venue: 'ic-ETITE',
    venueType: 'IEEE',
    year: 2020,
    citations: 0,
    doi: 'https://ieeexplore.ieee.org/document/9077722',
    link: 'https://ieeexplore.ieee.org/document/9077722',
    status: 'published',
    isFirstAuthor: false,
  },
];

const academicService: AcademicService[] = [
  {
    role: 'Programme Committee Member',
    conference: '17th International Conference on Swarm Intelligence',
    abbreviation: 'ICSI 2026',
    organizers: ['IASEI', 'Sichuan University', 'Peking University', 'IEEE CIS'],
    year: 2026,
    location: 'Chengdu, China',
    dates: 'Jul 11 · 14, 2026',
    details: 'Review 2-5 papers · Proceedings in Springer LNCS',
    invitedBy: 'Prof. Yuhui Shi',
  },
];

const totalCitations = publications.reduce((sum, p) => sum + p.citations, 0);
const hIndex = 2;

const venueColors: Record<string, string> = {
  IEEE: '#00629B',
  Springer: '#333333',
  Preprint: '#2ea44f',
};

const venueLabels: Record<string, string> = {
  IEEE: 'IEEE',
  Springer: 'Springer',
  Preprint: 'BioHackrXiv',
};
---

<section id="research" class="research-section relative bg-[--color-bg-primary] pt-4 pb-16 md:pt-6 md:pb-24">
  <div class="max-w-(--max-width)">
    <div class="section-header mb-6 flex items-baseline gap-4">
      <span class="text-5xl text-white/50 md:text-6xl" style="font-family: 'Viaoda Libre', serif;">04</span>
      <h2 class="text-5xl italic md:text-6xl" style="font-family: 'Instrument Serif', serif;">Research</h2>
    </div>

    <!-- Aggregate stats bar -->
    <div class="mb-12 flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-white/[0.06] pb-6">
      <span class="font-mono text-sm tabular-nums text-white/80">
        <span class="text-white font-medium">{publications.length}</span> Publications
      </span>
      <span class="text-white/20">·</span>
      <span class="font-mono text-sm tabular-nums text-white/80">
        <span class="text-white font-medium">{totalCitations}</span> Citations
      </span>
      <span class="text-white/20">·</span>
      <span class="font-mono text-sm tabular-nums text-white/80">
        h-index <span class="text-white font-medium">{hIndex}</span>
      </span>
      <a
        href="https://scholar.google.com/citations?user=5tb4VWYAAAAJ"
        target="_blank"
        rel="noopener noreferrer"
        class="scholar-stats-link ml-auto flex items-center gap-1.5 font-mono text-xs text-[--color-text-muted] transition-colors duration-200"
      >
        <span>Google Scholar</span>
        <svg class="scholar-stats-arrow h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
    </div>

    <!-- Publications subsection -->
    <div class="mb-16">
      <h3 class="mb-6 font-mono text-xs uppercase tracking-[0.2em] text-white/40">Publications</h3>

      <div class="publications-list space-y-0">
        {publications.map((pub, index) => (
          <a
            href={pub.link}
            target="_blank"
            rel="noopener noreferrer"
            class="publication-item group flex gap-4 border-b border-white/[0.06] py-5 transition-colors duration-200 md:gap-6"
            data-index={index}
          >
            {/* Year */}
            <span class="w-10 flex-shrink-0 pt-0.5 font-mono text-sm tabular-nums text-[--color-text-muted]">
              {pub.year}
            </span>

            {/* Main content */}
            <div class="min-w-0 flex-grow">
              {/* Top row: badge + citation + 1st author tag */}
              <div class="mb-2 flex flex-wrap items-center gap-2">
                <span
                  class="rounded px-1.5 py-0.5 font-mono text-[10px] leading-none"
                  style={`background: ${venueColors[pub.venueType]}20; color: ${venueColors[pub.venueType]};`}
                >
                  {venueLabels[pub.venueType]}
                </span>
                <span class="font-mono text-[10px] text-[--color-text-muted]">{pub.venue}</span>
                {pub.isFirstAuthor && (
                  <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-[10px] leading-none text-white/50">
                    1st Author
                  </span>
                )}
                {pub.citations > 0 && (
                  <span class="ml-auto flex items-center gap-1 font-mono text-[10px] tabular-nums text-[--color-text-muted]">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
                    </svg>
                    {pub.citations}
                  </span>
                )}
              </div>

              {/* Title */}
              <p class="pub-title text-sm leading-relaxed text-white/80 transition-colors duration-200 md:text-base">
                {pub.title}
              </p>

              {/* Authors */}
              <p class="mt-1.5 text-xs leading-relaxed text-[--color-text-muted]">
                {pub.authors.map((author, i) => (
                  <>
                    {author === pub.highlightAuthor ? (
                      <span class="font-medium text-white">{author}</span>
                    ) : (
                      <span>{author}</span>
                    )}
                    {i < pub.authors.length - 1 && ', '}
                  </>
                ))}
              </p>
            </div>

            {/* External link arrow */}
            <div class="pub-arrow flex-shrink-0 pt-0.5 text-[--color-text-muted] transition-all duration-200">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Academic Service subsection -->
    <div>
      <h3 class="mb-6 font-mono text-xs uppercase tracking-[0.2em] text-white/40">Academic Service</h3>

      {academicService.map((service) => (
        <div class="service-item rounded-lg border border-white/[0.06] bg-white/[0.02] p-5 md:p-6">
          {/* Role */}
          <p class="text-sm font-medium text-white md:text-base">{service.role}</p>

          {/* Conference */}
          <p class="mt-1 text-sm text-white/70">
            {service.conference}
            <span class="ml-2 font-mono text-xs text-[--color-text-muted]">{service.abbreviation}</span>
          </p>

          {/* Organizer pills */}
          <div class="mt-3 flex flex-wrap gap-1.5">
            {service.organizers.map((org) => (
              <span class="rounded bg-white/[0.06] px-2 py-0.5 font-mono text-[10px] text-white/50">
                {org}
              </span>
            ))}
          </div>

          {/* Meta row */}
          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-[--color-text-muted]">
            <span>{service.location}</span>
            <span class="text-white/20">·</span>
            <span>{service.dates}</span>
            {service.invitedBy && (
              <>
                <span class="text-white/20">·</span>
                <span>Invited by {service.invitedBy}</span>
              </>
            )}
          </div>

          {/* Details */}
          <p class="mt-2 font-mono text-xs text-[--color-text-muted]">{service.details}</p>
        </div>
      ))}
    </div>

    <!-- Scholar link -->
    <div class="mt-8 flex justify-end">
      <a
        href="https://scholar.google.com/citations?user=5tb4VWYAAAAJ"
        target="_blank"
        rel="noopener noreferrer"
        class="scholar-link group flex items-center gap-2 text-sm text-[--color-text-muted] transition-colors duration-200"
      >
        <span>View all on Google Scholar</span>
        <svg class="scholar-arrow h-4 w-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  async function initResearchAnimations() {
    const { scrollReveal, presets } = await import('../utils/scroll-animations');
    const items = document.querySelectorAll('.publication-item');
    scrollReveal(items, presets.fadeLeft);
  }

  window.addEventListener('intro-complete', () => initResearchAnimations(), { once: true });
</script>

<style>
  /* Touch device protection - only apply hover on devices with pointer */
  @media (hover: hover) and (pointer: fine) {
    .publication-item:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .publication-item:hover .pub-title {
      color: white;
    }

    .publication-item:hover .pub-arrow {
      transform: translateX(4px);
      color: white;
    }

    .scholar-link:hover {
      color: white;
    }

    .scholar-link:hover .scholar-arrow {
      transform: translateX(4px);
    }
  }
</style>
