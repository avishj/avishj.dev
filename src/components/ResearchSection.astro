---
interface Publication {
  title: string;
  authors: string[];
  highlightAuthor: string;
  venue: string;
  venueType: 'IEEE' | 'Springer' | 'Preprint';
  year: number;
  citations: number;
  doi?: string;
  link: string;
  status: 'published' | 'accepted' | 'preprint';
  isFirstAuthor?: boolean;
}

interface AcademicService {
  role: string;
  conference: string;
  abbreviation: string;
  organizers: string[];
  year: number;
  location: string;
  dates: string;
  details: string;
  invitedBy?: string;
}

