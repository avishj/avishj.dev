---
// Skills Section with tech stack pills and hover states
// Inspired by varshithm + pqoqubbw bordered skill pills

interface SkillCategory {
  name: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    name: 'Languages',
    skills: ['Java', 'Rust', 'Python', 'C++', 'C#', 'TypeScript', 'JavaScript', 'GoLang', 'SQL', 'C'],
  },
  {
    name: 'Tools & Technologies',
    skills: [
      'OpenXR', 'LibVNC', 'OpenTelemetry', 'Grafana', 'Prometheus', 'Loki',
      'Docker', 'Kubernetes', 'Azure', 'AWS', 'Linux',
      'SpringBoot', 'VueJS', 'AngularJS', 'TensorFlow',
      'Kafka', 'RabbitMQ', 'Redis', 'MongoDB',
      'MSTest', 'Playwright', 'Git',
    ],
  },
  {
    name: 'Leadership',
    skills: ['Team Management', 'Coordination', 'Prioritization', 'Problem Solving', 'Initiative'],
  },
];

const awards = [
  'Special Achiever\'s Award at VIT',
  'Treasurer at MSE Leadership Initiative (CMU)',
  'Committee on Student Organizations (CMU)',
  'Board Chairperson at Mozilla Firefox Club (VIT)',
  'Projects Head at Sigma Xi Research Society (VIT)',
];
---

<section id="skills" class="skills-section relative bg-[--color-bg-cream] py-24 text-[--color-text-dark] md:py-32">
  <!-- Section header -->
  <div class="max-w-(--max-width)">
    <div class="section-header mb-12 flex items-baseline gap-4">
      <span class="text-5xl text-[--color-text-dark]/50 md:text-6xl" style="font-family: 'Viaoda Libre', serif;">05</span>
      <h2 class="text-5xl italic text-[--color-text-dark] md:text-6xl" style="font-family: 'Instrument Serif', serif;">Skills & Recognition</h2>
    </div>

    <!-- Skills grid -->
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {skillCategories.map((category, catIndex) => (
        <div class="skill-category" data-index={catIndex}>
          <h3 class="mb-4 font-mono text-xs uppercase tracking-wider opacity-50">
            {category.name}
          </h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill, skillIndex) => (
              <span 
                class="skill-pill cursor-pointer select-none rounded-lg border border-black/10 bg-white px-3 py-1.5 font-mono text-xs transition-all duration-150 active:scale-[0.92]"
                style={`--delay: ${skillIndex * 30}ms;`}
                role="button"
                tabindex="0"
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Awards & Roles -->
    <div class="mt-16 border-t border-black/10 pt-12">
      <h3 class="mb-6 font-mono text-xs uppercase tracking-wider opacity-50">
        Awards & Roles
      </h3>
      <div class="flex flex-wrap gap-3">
        {awards.map((award, index) => (
          <div 
            class="award-item flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2 text-sm transition-all duration-200"
            style={`--delay: ${index * 50}ms;`}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-black/20"></span>
            <span>{award}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Education callout -->
    <div class="education-callout mt-16 rounded-2xl border border-black/10 bg-white p-6 md:p-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="font-display text-xl font-medium tracking-tight md:text-2xl">Carnegie Mellon University</h3>
          <p class="mt-1 text-black/60">MS Computer Software Engineering in Scalable Systems</p>
          <p class="mt-2 text-sm text-black/50">School of Computer Science · Teaching Assistant: 17-614 Formal Methods</p>
        </div>
        <div class="flex flex-col items-end text-right">
          <span class="font-display text-3xl font-medium tracking-tight md:text-4xl">4.17</span>
          <span class="font-mono text-xs uppercase tracking-wider opacity-50">QPA / 4.00</span>
          <span class="mt-1 font-mono text-sm tabular-nums text-black/60">Dec 2025</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initSkillsAnimations() {
    const viewportBottom = window.scrollY + window.innerHeight;
    
    // Skill categories
    const categories = document.querySelectorAll('.skill-category');
    categories.forEach((cat, index) => {
      const rect = cat.getBoundingClientRect();
      const elTop = window.scrollY + rect.top;
      const isAlreadyVisible = elTop < viewportBottom;
      
      gsap.set(cat, { y: 20, opacity: 0 });
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: cat,
          start: 'top 85%',
          toggleActions: 'play none play reverse',
        },
        delay: index * 0.15,
      }).to(cat, {
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: 'power4.out',
      });
      
      if (isAlreadyVisible) {
        tl.progress(1);
      }
    });

    // Skill pills
    const pills = document.querySelectorAll('.skill-pill');
    pills.forEach((pill, index) => {
      const rect = pill.getBoundingClientRect();
      const elTop = window.scrollY + rect.top;
      const isAlreadyVisible = elTop < viewportBottom;
      
      gsap.set(pill, { scale: 0.9, opacity: 0 });
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pill,
          start: 'top 85%',
          toggleActions: 'play none play none',
        },
        delay: index * 0.02,
      }).to(pill, {
        scale: 1,
        opacity: 1,
        duration: 0.6,
        ease: 'power4.out',
      });
      
      if (isAlreadyVisible) {
        tl.progress(1);
      }
    });

    // Education callout
    const callout = document.querySelector('.education-callout');
    if (callout) {
      const rect = callout.getBoundingClientRect();
      const elTop = window.scrollY + rect.top;
      const isAlreadyVisible = elTop < viewportBottom;
      
      gsap.set(callout, { y: 30, opacity: 0 });
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: callout,
          start: 'top 85%',
          toggleActions: 'play none play reverse',
        },
      }).to(callout, {
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: 'power4.out',
      });
      
      if (isAlreadyVisible) {
        tl.progress(1);
      }
    }
    
    ScrollTrigger.refresh();
  }

  window.addEventListener('intro-complete', initSkillsAnimations, { once: true });
</script>

<style>
  .skill-pill {
    animation: fadeIn 0.3s ease-out backwards;
    animation-delay: var(--delay);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Touch device protection - only apply hover on devices with pointer */
  @media (hover: hover) and (pointer: fine) {
    .skill-pill:hover {
      border-color: rgba(0, 0, 0, 0.3);
      background: black;
      color: white;
    }

    .award-item:hover {
      border-color: rgba(0, 0, 0, 0.2);
    }

    .education-callout:hover {
      border-color: rgba(0, 0, 0, 0.15);
      box-shadow: 
        0 4px 24px rgba(0, 0, 0, 0.08),
        0 0 0 1px rgba(0, 0, 0, 0.04);
    }
  }
</style>
