---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Avish Jha · Software Engineer',
  description = 'CMU MS Software Engineering graduate. Experience at Snap, Siemens Healthineers, Addverb, MITACS. Published researcher (IEEE, Springer, Elsevier).',
} = Astro.props;

import { url } from '../utils/url';
import RedirectOverlay from '../components/RedirectOverlay.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Avish Jha" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://avishj.dev" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <title>{title}</title>
  </head>
  <body class="grain-overlay">
    <slot />
    <RedirectOverlay />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
