---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortalBurn from "../../components/PortalBurn.astro";
import BackButton from "../../components/BackButton.astro";
import { getCollection } from "astro:content";
import { url } from "../../utils/url";
import { formatDate } from "../../utils/date";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Avish Jha · Blog" description="Thoughts on software engineering, research, and more.">
	<!-- Intro Splash -->
	<div id="intro-splash" class="fixed inset-0 z-50 bg-[--color-bg-primary]"></div>

	<!-- Fire Effect -->
	<PortalBurn />

	<div id="main-content" class="invisible min-h-screen bg-[--color-bg-primary] opacity-0">
		<div class="mx-auto max-w-2xl px-6 lg:px-8">
			<!-- Header -->
			<header class="pb-6 pt-8 lg:pb-8 lg:pt-12">
				<div class="flex items-center gap-4">
					<BackButton href={url("")} text="back" />
				</div>
				<h1 class="mt-8 font-display text-5xl font-medium italic tracking-tight text-white lg:text-6xl">Avish's Blog</h1>
				<p class="mt-3 font-mono text-sm tracking-wide text-white/40">Thoughts on software engineering, research, and other random musings.</p>
			</header>

			<!-- Post List -->
			<main class="pb-16">
				<div>
					{
						posts.length === 0 ? (
							<p class="text-white/50 font-mono text-sm">No posts yet. Check back soon!</p>
						) : (
							<ul class="space-y-8">
								{posts.map((post) => (
									<li>
										<a href={url(`blog/${post.slug}/`)} class="group block rounded-lg border border-transparent p-4 -mx-4 transition-colors hover:border-white/10 hover:bg-white/[0.02]">
											<time class="font-mono text-xs tracking-wide text-white/40">{formatDate(post.data.pubDate)}</time>
											<h2 class="mt-1 font-display text-2xl italic text-white transition-colors group-hover:text-white/90">{post.data.title}</h2>
											<p class="mt-2 text-sm leading-relaxed text-white/50">{post.data.description}</p>
										</a>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</main>

			<!-- Footer -->
			<footer class="py-12">
				<div class="border-t border-white/[0.06] pt-8">
					<p class="font-mono text-xs text-[--color-text-muted]">© {new Date().getFullYear()} Avish Jha</p>
				</div>
			</footer>
		</div>
	</div>

	<script>
		import { initPageTransition } from "../../utils/portal-transition";
		initPageTransition("intro-splash", "main-content");
	</script>

	<style>
		@media (prefers-reduced-motion: reduce) {
			#intro-splash {
				display: none;
			}
			#main-content {
				visibility: visible !important;
				opacity: 1 !important;
			}
		}
	</style>
</BaseLayout>
