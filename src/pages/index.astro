---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingContact from '../components/FloatingContact.astro';
import AboutSection from '../components/AboutSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ResearchSection from '../components/ResearchSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import PortalBurn from '../components/PortalBurn.astro';
---

<BaseLayout>
  <!-- ═══════════════════════════════════════════════════════════════════════════
       INTRO SPLASH — Calligraphy signature draws in, then swirls away
       ═══════════════════════════════════════════════════════════════════════════ -->
  <div id="intro-splash" class="fixed inset-0 z-50 flex items-center justify-center bg-[--color-bg-primary]">
    <div id="lottie-container"></div>
    
    </div>
  
  <!-- Three.js Portal Burn Effect -->
  <PortalBurn />

  <main id="main-content" class="invisible opacity-0">
    <!-- ═══════════════════════════════════════════════════════════════════════════
         MAIN LAYOUT — Name top-left, sections nav on right
         ═══════════════════════════════════════════════════════════════════════════ -->
    <div class="min-h-screen bg-[--color-bg-primary]">
      
      <!-- Name header — scrolls with page -->
      <header class="px-6 pb-6 pt-8 lg:px-12 lg:pb-8 lg:pt-12">
        <!-- Top row: Name + Links -->
        <div class="flex items-start justify-between">
          <a href="#" class="block">
            <h1 class="font-display text-5xl font-medium tracking-tight text-white lg:text-6xl xl:text-7xl">
              Avish Jha
            </h1>
          </a>
          
          <!-- Navigation links -->
          <nav class="flex items-center gap-5 pt-2 lg:gap-6 lg:pt-3">
            <a href="/Jha, Avish - Resume.pdf" target="_blank" rel="noopener noreferrer" download class="header-link group flex items-center gap-1.5">
              <span class="header-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease group-hover:text-white/90 lg:text-base">resume</span>
              <svg class="h-3 w-3 text-white/30 transition-colors duration-150 ease group-hover:text-white/70 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
            </a>
            <a href="/blog/" class="header-link group flex items-center gap-1.5">
              <span class="header-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease group-hover:text-white/90 lg:text-base">blog</span>
              <svg class="h-3 w-3 text-white/30 transition-colors duration-150 ease group-hover:text-white/70 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </a>
            <a href="/research/" class="header-link group flex items-center gap-1.5">
              <span class="header-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease group-hover:text-white/90 lg:text-base">research</span>
              <svg class="h-3 w-3 text-white/30 transition-colors duration-150 ease group-hover:text-white/70 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </a>
            <a href="https://github.com/avishj" target="_blank" rel="noopener noreferrer" class="header-link group hidden items-center gap-1.5 lg:flex">
              <span class="header-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease group-hover:text-white/90 lg:text-base">github</span>
              <svg class="h-3 w-3 text-white/30 transition-colors duration-150 ease group-hover:text-white/70 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </a>
            <a href="https://scholar.google.com/citations?user=5tb4VWYAAAAJ" target="_blank" rel="noopener noreferrer" class="header-link group hidden items-center gap-1.5 lg:flex">
              <span class="header-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease group-hover:text-white/90 lg:text-base">scholar</span>
              <svg class="h-3 w-3 text-white/30 transition-colors duration-150 ease group-hover:text-white/70 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </a>
            <a href="https://linkedin.com/in/avishj" target="_blank" rel="noopener noreferrer" class="header-link group hidden items-center gap-1.5 lg:flex">
              <span class="header-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease group-hover:text-white/90 lg:text-base">linkedin</span>
              <svg class="h-3 w-3 text-white/30 transition-colors duration-150 ease group-hover:text-white/70 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </a>
          </nav>
        </div>
        
        <!-- Subtitle row -->
        <p class="mt-3 font-mono text-sm tracking-[0.2em] text-white/40 lg:mt-4 lg:text-base">
          Software Engineer · CMU
        </p>
      </header>

      <!-- Fixed vertical section nav — right side -->
      <nav id="section-nav" class="fixed right-6 top-1/2 z-40 hidden -translate-y-1/2 lg:right-12 lg:block">
        <ul class="flex flex-col gap-5">
          <li>
            <a href="#about" class="nav-link group flex items-center gap-3" data-section="about">
              <span class="nav-line h-px w-6 bg-white/20 transition-all duration-300 group-hover:w-10 group-hover:bg-white/60"></span>
              <span class="nav-text font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 transition-colors duration-300 group-hover:text-white/80">About</span>
            </a>
          </li>
          <li>
            <a href="#experience" class="nav-link group flex items-center gap-3" data-section="experience">
              <span class="nav-line h-px w-6 bg-white/20 transition-all duration-300 group-hover:w-10 group-hover:bg-white/60"></span>
              <span class="nav-text font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 transition-colors duration-300 group-hover:text-white/80">Experience</span>
            </a>
          </li>
          <li>
            <a href="#projects" class="nav-link group flex items-center gap-3" data-section="projects">
              <span class="nav-line h-px w-6 bg-white/20 transition-all duration-300 group-hover:w-10 group-hover:bg-white/60"></span>
              <span class="nav-text font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 transition-colors duration-300 group-hover:text-white/80">Projects</span>
            </a>
          </li>
          <li>
            <a href="#research" class="nav-link group flex items-center gap-3" data-section="research">
              <span class="nav-line h-px w-6 bg-white/20 transition-all duration-300 group-hover:w-10 group-hover:bg-white/60"></span>
              <span class="nav-text font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 transition-colors duration-300 group-hover:text-white/80">Research</span>
            </a>
          </li>
          <li>
            <a href="#skills" class="nav-link group flex items-center gap-3" data-section="skills">
              <span class="nav-line h-px w-6 bg-white/20 transition-all duration-300 group-hover:w-10 group-hover:bg-white/60"></span>
              <span class="nav-text font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 transition-colors duration-300 group-hover:text-white/80">Skills</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Scrollable content area -->
      <div class="content-area px-6 lg:mr-[180px] lg:px-12">
        <section id="about"><AboutSection /></section>
        <section id="experience"><ExperienceSection /></section>
        <section id="projects"><ProjectsSection /></section>
        <section id="research"><ResearchSection /></section>
        <section id="skills"><SkillsSection /></section>
      </div>

      <!-- Footer -->
      <footer class="bg-[--color-bg-primary] px-6 py-12 lg:mr-[180px] lg:px-12">
        <div class="px-6">
          <div class="flex flex-col items-center justify-between gap-4 border-t border-white/[0.06] pt-8 md:flex-row">
            <p class="font-mono text-xs text-[--color-text-muted]">
              © 2025 Avish Jha · Built with intention
            </p>
            <p class="font-mono text-xs text-[--color-text-muted]">
              Pittsburgh, PA
            </p>
          </div>
        </div>
      </footer>
    </div>
  </main>

  <FloatingContact />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import lottie from 'lottie-web';

  gsap.registerPlugin(ScrollTrigger);

  // ═══════════════════════════════════════════════════════════════════════════
  // INTRO ANIMATION — Lottie signature draws, then swirls away
  // ═══════════════════════════════════════════════════════════════════════════
  const introSplash = document.getElementById('intro-splash');
  const lottieContainer = document.getElementById('lottie-container');
  const mainContent = document.getElementById('main-content');

  if (lottieContainer && introSplash && mainContent) {
    // Disable scrolling during intro
    document.body.style.overflow = 'hidden';

    // Load Lottie animation
    const anim = lottie.loadAnimation({
      container: lottieContainer,
      renderer: 'svg',
      loop: false,
      autoplay: true,
      path: '/lottie/signature.json',
    });

    anim.addEventListener('complete', () => {
      // Get burn origin from Lottie container position
      // Use the right-center of the signature as origin
      const lottieRect = lottieContainer.getBoundingClientRect();
      const originX = lottieRect.left + lottieRect.width * 0.75;
      const originY = lottieRect.top + lottieRect.height * 0.55;
      
      // Show main content behind the effect
      mainContent.style.visibility = 'visible';
      mainContent.style.opacity = '1';
      
      // Fade out the lottie
      gsap.to(lottieContainer, {
        opacity: 0,
        duration: 0.5,
        ease: 'power2.in',
      });
      
      // Start the Three.js portal burn effect
      if ((window as any).initPortalBurn) {
        (window as any).initPortalBurn(originX, originY, () => {
          // Cleanup after effect completes
          introSplash.remove();
          document.body.style.overflow = '';
        });
      } else {
        // Fallback if Three.js effect not loaded
        gsap.to(introSplash, {
          opacity: 0,
          duration: 0.8,
          onComplete: () => {
            introSplash.remove();
            document.body.style.overflow = '';
          }
        });
      }
    });

    // Fallback if animation takes too long or fails
    anim.addEventListener('data_failed', () => {
      gsap.to(introSplash, {
        opacity: 0,
        duration: 0.5,
        onComplete: () => {
          introSplash.remove();
          document.body.style.overflow = '';
          gsap.set(mainContent, { visibility: 'visible', opacity: 1 });
        }
      });
    });

    // Safety timeout (animation is ~2.5s + 1.2s swirl = ~4s total)
    setTimeout(() => {
      if (introSplash.parentNode) {
        anim.stop();
        gsap.to(introSplash, {
          opacity: 0,
          duration: 0.5,
          onComplete: () => {
            introSplash.remove();
            document.body.style.overflow = '';
            gsap.set(mainContent, { visibility: 'visible', opacity: 1 });
          }
        });
      }
    }, 6000);
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // SECTION NAV HIGHLIGHTING — Update active state on scroll
  // ═══════════════════════════════════════════════════════════════════════════
  const sections = ['about', 'experience', 'projects', 'research', 'skills'];
  const navLinks = document.querySelectorAll('.nav-link');

  sections.forEach((sectionId) => {
    const section = document.getElementById(sectionId);
    if (!section) return;

    ScrollTrigger.create({
      trigger: section,
      start: 'top center',
      end: 'bottom center',
      onEnter: () => setActiveNav(sectionId),
      onEnterBack: () => setActiveNav(sectionId),
    });
  });

  function setActiveNav(activeId: string) {
    navLinks.forEach((link) => {
      const linkSection = link.getAttribute('data-section');
      const line = link.querySelector('.nav-line');
      const text = link.querySelector('.nav-text');
      
      if (linkSection === activeId) {
        line?.classList.add('w-10', 'bg-white/80');
        line?.classList.remove('w-6', 'bg-white/20');
        text?.classList.add('text-white');
        text?.classList.remove('text-white/40');
      } else {
        line?.classList.remove('w-10', 'bg-white/80');
        line?.classList.add('w-6', 'bg-white/20');
        text?.classList.remove('text-white');
        text?.classList.add('text-white/40');
      }
    });
  }

  // Smooth scroll for nav links
  navLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = link.getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        target?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     LOTTIE CONTAINER
     ═══════════════════════════════════════════════════════════════════════════ */
  #lottie-container {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lottie-container svg {
    width: 100%;
    height: auto;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     NAV ACTIVE STATES
     ═══════════════════════════════════════════════════════════════════════════ */
  .nav-link.active .nav-line {
    width: 2.5rem;
    background-color: rgba(255, 255, 255, 0.8);
  }

  .nav-link.active .nav-text {
    color: white;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     HEADER LINK ANIMATED DOTTED UNDERLINE
     ═══════════════════════════════════════════════════════════════════════════ */
  .header-link {
    will-change: transform;
    transition: transform 150ms ease-out;
  }

  .header-link:hover {
    transform: translateX(2px);
  }

  .header-link:active {
    transform: scale(0.97);
  }

  .header-link-text {
    position: relative;
    padding-bottom: 3px;
  }

  .header-link-text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-image: repeating-linear-gradient(
      to right,
      rgba(255, 255, 255, 0.3) 0px,
      rgba(255, 255, 255, 0.3) 2px,
      transparent 2px,
      transparent 6px
    );
    background-size: 6px 1px;
    will-change: background-position;
  }

  .header-link:hover .header-link-text::after {
    background-image: repeating-linear-gradient(
      to right,
      rgba(255, 255, 255, 0.7) 0px,
      rgba(255, 255, 255, 0.7) 2px,
      transparent 2px,
      transparent 6px
    );
    animation: dotScroll 400ms linear infinite;
  }

  /* Arrow icon nudge on hover */
  .header-link svg {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .header-link:hover svg {
    transform: translate(1px, -1px);
  }

  @keyframes dotScroll {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 6px 0;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    #intro-splash {
      display: none;
    }
    #main-content {
      visibility: visible !important;
      opacity: 1 !important;
    }
    .header-link-text::after {
      animation: none;
    }
    .header-link,
    .header-link svg {
      transition: none;
    }
  }
</style>
