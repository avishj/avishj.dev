---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortalBurn from "../../components/PortalBurn.astro";
import BackButton from "../../components/BackButton.astro";
import Footer from "../../components/Footer.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import CitationCopy from "../../components/CitationCopy.astro";
import { publications, venueColors, venueLabels, getDisplayAuthors } from "../../data/publications";
import { url } from "../../utils/url";

export function getStaticPaths() {
	return publications.map((pub) => ({
		params: { slug: pub.slug },
		props: { publication: pub }
	}));
}

const { publication: pub } = Astro.props;
const displayAuthors = getDisplayAuthors(pub);
// If link points to our internal viewer, we have a PDF
const hasPdf = pub.link.includes("view/");
---

<BaseLayout title={`${pub.title} · Avish Jha`} description={pub.abstract || pub.title}>
	<div id="intro-splash" class="fixed inset-0 z-50 bg-[--color-bg-primary]"></div>
	<PortalBurn />

	<div id="main-content" class="invisible min-h-screen bg-[--color-bg-primary] opacity-0">
		<div class="mx-auto max-w-3xl px-6 lg:px-8">
			<!-- Header -->
			<header class="pb-6 pt-8 lg:pb-8 lg:pt-12">
				<BackButton href={url("research/")} text="research" />
			</header>

			<main class="pb-16">
				<!-- Venue/year row -->
				<div class="paper-meta mb-3 flex flex-wrap items-center gap-2">
					<span class="rounded px-1.5 py-0.5 font-mono text-sm leading-none" style={`background: ${venueColors[pub.venueType]}20; color: ${venueColors[pub.venueType]};`}>
						{venueLabels[pub.venueType]}
					</span>
					<span class="font-mono text-sm text-[--color-text-muted]">{pub.venue} · {pub.year}</span>
					{pub.isFirstAuthor && <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-sm leading-none text-white/50">1st Author</span>}
					{pub.status === "preprint" && <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-sm leading-none text-white/50">Preprint</span>}
				</div>

				<!-- Title -->
				<h1 class="paper-title font-display text-3xl font-medium italic leading-snug text-white lg:text-4xl">{pub.title}</h1>

				<!-- Authors -->
				<p class="paper-authors mt-4 text-sm leading-relaxed text-[--color-text-muted]">
					{
						displayAuthors.authors.map((da) => (
							<Fragment>
								{da.isHighlight ? <span class="font-semibold text-white/80">{da.name}</span> : <span>{da.name}</span>}
								{da.separator}
							</Fragment>
						))
					}
					{displayAuthors.truncated && <span class="italic">et al.</span>}
				</p>

				<!-- Divider -->
				<div class="my-8 border-t border-white/[0.06]"></div>

				<!-- Abstract -->
				{
					pub.abstract && (
						<section class="paper-section mb-8">
							<h2 class="mb-3 font-mono text-sm uppercase tracking-[0.15em] text-white/40">Abstract</h2>
							<p class="text-sm leading-relaxed text-white/70 whitespace-pre-line">{pub.abstract}</p>
						</section>
					)
				}

				<!-- Key Findings -->
				{
					pub.keyFindings.length > 0 && (
						<section class="paper-section mb-8">
							<h2 class="mb-3 font-mono text-sm uppercase tracking-[0.15em] text-white/40">Key Findings</h2>
							<ul class="space-y-2">
								{pub.keyFindings.map((finding) => (
									<li class="flex items-start gap-2 text-sm leading-relaxed text-white/70">
										<span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-white/30" />
										<span>{finding}</span>
									</li>
								))}
							</ul>
						</section>
					)
				}

				<!-- Divider -->
				<div class="my-8 border-t border-white/[0.06]"></div>

				<!-- Metrics row -->
				<div class="paper-metrics mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-sm text-[--color-text-muted]">
					{
						pub.publishedDate && (
							<span>
								Published: <span class="text-white/70">{pub.publishedDate}</span>
							</span>
						)
					}
					{
						pub.citations > 0 && (
							<span>
								Citations: <span class="text-white/70">{pub.citations}</span>
							</span>
						)
					}
					{
						pub.doi && (
							<span>
								DOI:{" "}
								<a href={pub.doi} target="_blank" rel="noopener noreferrer" class="text-white/50 underline underline-offset-2 transition-colors duration-150 hover:text-white/80">
									{pub.doi.replace(/^https?:\/\/(doi\.org\/)?/, "")}
								</a>
							</span>
						)
					}
				</div>

				<!-- Actions -->
				<div class="paper-actions flex flex-wrap items-center gap-3">
					{
						hasPdf && (
							<a href={pub.link} class="action-link group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-[--color-text-muted]">
								<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
								</svg>
								<span>View PDF</span>
							</a>
						)
					}

					{pub.bibtex && <CitationCopy bibtex={pub.bibtex} />}

					{
						pub.doi && (
							<a href={pub.doi} target="_blank" rel="noopener noreferrer" class="action-link group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-[--color-text-muted]">
								<span>Publisher</span>
								<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
							</a>
						)
					}
				</div>
			</main>

			<Footer />
		</div>
	</div>
</BaseLayout>

<script>
	import { initPageTransition } from "../../utils/portal-transition";
	initPageTransition("intro-splash", "main-content");
</script>

<script>
	async function initPaperPageAnimations() {
		const { scrollRevealTimeline, tlFadeUp, TIMELINE_OVERLAP } = await import("../../utils/scroll-animations");

		const main = document.querySelector("main");
		if (!main) return;

		const meta = main.querySelector(".paper-meta");
		const title = main.querySelector(".paper-title");
		const authors = main.querySelector(".paper-authors");
		const sections = main.querySelectorAll(".paper-section");
		const metrics = main.querySelector(".paper-metrics");
		const actions = main.querySelector(".paper-actions");

		scrollRevealTimeline(main, (tl) => {
			tl.fromTo(...tlFadeUp(meta))
				.fromTo(...tlFadeUp(title), TIMELINE_OVERLAP)
				.fromTo(...tlFadeUp(authors), TIMELINE_OVERLAP);

			sections.forEach((section) => {
				tl.fromTo(...tlFadeUp(section), TIMELINE_OVERLAP);
			});

			if (metrics) tl.fromTo(...tlFadeUp(metrics), TIMELINE_OVERLAP);
			if (actions) tl.fromTo(...tlFadeUp(actions), TIMELINE_OVERLAP);
		});
	}

	window.addEventListener("intro-complete", () => initPaperPageAnimations(), { once: true });

	if (document.getElementById("main-content")?.style.opacity === "1") {
		initPaperPageAnimations();
	}
</script>

<style>
	.action-link {
		transition:
			background-color 200ms ease,
			border-color 200ms ease,
			color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.action-link:hover {
			background: rgba(255, 255, 255, 0.03);
			border-color: rgba(255, 255, 255, 0.12);
			color: white;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#intro-splash {
			display: none;
		}
		#main-content {
			visibility: visible !important;
			opacity: 1 !important;
		}
		.action-link {
			transition: none;
		}
	}
</style>
