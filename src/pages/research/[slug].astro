---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortalBurn from "../../components/PortalBurn.astro";
import BackButton from "../../components/BackButton.astro";
import Footer from "../../components/Footer.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import CitationCopy from "../../components/CitationCopy.astro";
import { publications, venueColors, venueLabels, getDisplayAuthors } from "../../data/publications";
import { url } from "../../utils/url";

export function getStaticPaths() {
	return publications.map((pub) => ({
		params: { slug: pub.slug },
		props: { publication: pub }
	}));
}

const { publication: pub } = Astro.props;
const displayAuthors = getDisplayAuthors(pub);
// If link points to our internal viewer, we have a PDF
const hasPdf = url(pub.link).includes("view/");
const abstractSentences = pub.abstract
	? pub.abstract.split(/(?<=\.)\s+/).filter((s) => s.trim())
	: [];
---

<BaseLayout title={`${pub.title} · Avish Jha`} description={pub.abstract || pub.title}>
	<div id="intro-splash" class="fixed inset-0 z-50 bg-[--color-bg-primary]"></div>
	<PortalBurn />

	<div id="main-content" class="invisible min-h-screen bg-[--color-bg-primary] opacity-0">
		<div class="mx-auto max-w-3xl px-6 lg:px-8">
			<!-- Header -->
			<header class="pb-6 pt-8 lg:pb-8 lg:pt-12">
				<BackButton fallbackHref={url("research/")} />
			</header>

			<main class="pb-16">
				<!-- Group 1: Header info (in view on load) -->
				<div class="anim-group-header">
					<div class="paper-meta mb-3 flex flex-wrap items-center gap-2">
						<span class="rounded px-1.5 py-0.5 font-mono text-sm leading-none" style={`background: ${venueColors[pub.venueType]}20; color: ${venueColors[pub.venueType]};`}>
							{venueLabels[pub.venueType]}
						</span>
						<span class="font-mono text-sm text-[--color-text-muted]">{pub.venue} · {pub.year}</span>
						{pub.isFirstAuthor && <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-sm leading-none text-white/50">1st Author</span>}
						{pub.status === "preprint" && <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-sm leading-none text-white/50">Preprint</span>}
					</div>

					<h1 class="paper-title font-display text-3xl font-medium italic leading-snug text-white lg:text-4xl">{pub.title}</h1>

					<p class="paper-authors mt-4 text-sm leading-relaxed text-[--color-text-muted]">
						{
							displayAuthors.authors.map((da) => (
								<Fragment>
									{da.isHighlight ? <span class="highlight-author font-semibold">{da.name}</span> : <span>{da.name}</span>}
									{da.separator}
								</Fragment>
							))
						}
						{displayAuthors.truncated && <span class="italic">et al.</span>}
					</p>
				</div>

				<!-- Group 2: Abstract + Key Findings (sentence-level scroll triggers) -->
				<div class="anim-group-content">
					<div class="paper-divider my-8 border-t border-white/[0.06]"></div>

					{
						abstractSentences.length > 0 && (
							<section class="mb-8">
								<h2 class="abstract-heading mb-3 font-mono text-sm uppercase tracking-[0.15em] text-white/40">Abstract</h2>
								<p class="text-sm leading-relaxed text-white/70">
									{abstractSentences.map((sentence) => (
										<span class="abstract-sentence inline">{sentence} </span>
									))}
								</p>
							</section>
						)
					}

					{
						pub.keyFindings.length > 0 && (
							<section class="mb-8">
								<h2 class="findings-heading mb-3 font-mono text-sm uppercase tracking-[0.15em] text-white/40">Key Findings</h2>
								<ul class="space-y-2">
									{pub.keyFindings.map((finding) => (
										<li class="finding-item flex items-start gap-2 text-sm leading-relaxed text-white/70">
											<span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-white/30" />
											<span>{finding}</span>
										</li>
									))}
								</ul>
							</section>
						)
					}
				</div>

				<!-- Group 3: Actions (CTA + metrics + cite) -->
				<div class="anim-group-actions">
					<div class="paper-divider my-8 border-t border-white/[0.06]"></div>

					{
						hasPdf && (
							<a href={url(pub.link)} class="read-paper-cta group mb-8 flex w-full items-center justify-center gap-3 rounded-xl border border-white/[0.08] py-3.5 font-mono text-sm text-white/80 active:scale-[0.97]">
								<svg class="h-4 w-4 text-white/50 transition-colors duration-200 group-hover:text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
								</svg>
								<span>Read Paper</span>
								<ArrowIcon class="h-3.5 w-3.5" hover="white" />
							</a>
						)
					}

					<div class="paper-metrics mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
						{
							pub.publishedDate && (
								<div class="metric-card rounded-lg border border-white/[0.06] px-4 py-3">
									<span class="block font-mono text-[10px] uppercase tracking-[0.15em] text-white/30">Published</span>
									<span class="mt-1 block font-mono text-sm text-white/70">{pub.publishedDate}</span>
								</div>
							)
						}
						{
							pub.citations > 0 && (
								<div class="metric-card rounded-lg border border-white/[0.06] px-4 py-3">
									<span class="block font-mono text-[10px] uppercase tracking-[0.15em] text-white/30">Citations</span>
									<span class="mt-1 block font-number text-lg text-white/70">{pub.citations}</span>
								</div>
							)
						}
						{
							pub.doi && (
								<a href={pub.doi} target="_blank" rel="noopener noreferrer" class="metric-card group rounded-lg border border-white/[0.06] px-4 py-3">
									<span class="flex items-center gap-1.5">
										<span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/30">DOI</span>
										<ArrowIcon class="h-2.5 w-2.5 text-white/20" hover="white" />
									</span>
									<span class="mt-1 block truncate font-mono text-xs text-white/50 transition-colors duration-200 group-hover:text-white/70">{pub.doi.replace(/^https?:\/\/(doi\.org\/)?/, "")}</span>
								</a>
							)
						}
					</div>

					<div class="paper-actions">
						{pub.bibtex && <CitationCopy bibtex={pub.bibtex} />}
					</div>
				</div>
			</main>

			<Footer />
		</div>
	</div>
</BaseLayout>

<script>
	import { initPageTransition } from "../../utils/portal-transition";
	initPageTransition("intro-splash", "main-content");
</script>

<script>
	async function initPaperPageAnimations() {
		const { scrollRevealTimeline, tlFadeUp, tlFadeIn, tlScaleUp, TIMELINE_OVERLAP } = await import("../../utils/scroll-animations");

		const main = document.querySelector("main");
		if (!main) return;

		const headerGroup = main.querySelector(".anim-group-header");
		if (headerGroup) {
			scrollRevealTimeline(headerGroup, (tl) => {
				const meta = headerGroup.querySelector(".paper-meta");
				const title = headerGroup.querySelector(".paper-title");
				const authors = headerGroup.querySelector(".paper-authors");
				tl.fromTo(...tlFadeUp(meta))
					.fromTo(...tlFadeUp(title), TIMELINE_OVERLAP)
					.fromTo(...tlFadeUp(authors), TIMELINE_OVERLAP);
			});
		}

		const contentGroup = main.querySelector(".anim-group-content");
		if (contentGroup) {
			const divider = contentGroup.querySelector(".paper-divider");
			const abstractHeading = contentGroup.querySelector(".abstract-heading");
			const abstractSentences = contentGroup.querySelectorAll(".abstract-sentence");
			const findingsHeading = contentGroup.querySelector(".findings-heading");
			const findingItems = contentGroup.querySelectorAll(".finding-item");

			if (divider) {
				scrollRevealTimeline(divider, (tl) => {
					tl.fromTo(...tlFadeIn(divider));
				});
			}
			if (abstractHeading) {
				scrollRevealTimeline(abstractHeading, (tl) => {
					tl.fromTo(...tlFadeUp(abstractHeading));
				});
			}
			abstractSentences.forEach((sentence) => {
				scrollRevealTimeline(sentence, (tl) => {
					tl.fromTo(...tlFadeUp(sentence));
				});
			});
			if (findingsHeading) {
				scrollRevealTimeline(findingsHeading, (tl) => {
					tl.fromTo(...tlFadeUp(findingsHeading));
				});
			}
			findingItems.forEach((item) => {
				scrollRevealTimeline(item, (tl) => {
					tl.fromTo(...tlFadeUp(item));
				});
			});
		}

		const actionsGroup = main.querySelector(".anim-group-actions");
		if (actionsGroup) {
			const divider = actionsGroup.querySelector(".paper-divider");
			const cta = actionsGroup.querySelector(".read-paper-cta");
			const metricCards = actionsGroup.querySelectorAll(".metric-card");
			const actions = actionsGroup.querySelector(".paper-actions");

			if (divider) {
				scrollRevealTimeline(divider, (tl) => {
					tl.fromTo(...tlFadeIn(divider));
				});
			}
			if (cta) {
				scrollRevealTimeline(cta, (tl) => {
					tl.fromTo(...tlFadeUp(cta));
				});
			}
			if (metricCards.length) {
				scrollRevealTimeline(metricCards[0].parentElement!, (tl) => {
					tl.fromTo(...tlScaleUp(metricCards, { stagger: 0.06 }));
				});
			}
			if (actions) {
				scrollRevealTimeline(actions, (tl) => {
					tl.fromTo(...tlFadeUp(actions));
				});
			}
		}
	}

	window.addEventListener("intro-complete", () => initPaperPageAnimations(), { once: true });

	if (document.getElementById("main-content")?.style.opacity === "1") {
		initPaperPageAnimations();
	}
</script>

<style>
	.read-paper-cta {
		cursor: pointer;
		will-change: transform;
		transition:
			border-color 200ms ease,
			background-color 200ms ease,
			box-shadow 300ms ease;
	}

	.metric-card {
		cursor: default;
		will-change: transform;
		transition:
			border-color 200ms ease,
			background-color 200ms ease,
			transform 200ms var(--ease-out-expo);
	}

	a.metric-card {
		cursor: pointer;
	}

	@media (hover: hover) and (pointer: fine) {
		.read-paper-cta:hover {
			border-color: rgba(255, 255, 255, 0.2);
			background: rgba(255, 255, 255, 0.04);
			box-shadow: inset 0 0 40px rgba(255, 255, 255, 0.02);
		}

		.metric-card:hover {
			border-color: rgba(255, 255, 255, 0.12);
			background: rgba(255, 255, 255, 0.03);
			transform: scale(1.02);
		}
	}

	@property --border-angle {
		syntax: "<angle>";
		initial-value: 0deg;
		inherits: false;
	}

	.highlight-author {
		--glow: #e0a860;
		position: relative;
		color: var(--glow);
		padding: 1px 6px;
		border-radius: 4px;
		background: linear-gradient(var(--border-angle), rgba(224, 168, 96, 0.1) 0%, rgba(224, 168, 96, 0.03) 50%, rgba(224, 168, 96, 0.1) 100%);
		border: 1px solid transparent;
		background-clip: padding-box;
		animation: rotate-border 3s linear infinite;
	}

	.highlight-author::before {
		content: "";
		position: absolute;
		inset: -1px;
		border-radius: 5px;
		padding: 1px;
		background: conic-gradient(from var(--border-angle), rgba(224, 168, 96, 0.06), rgba(224, 168, 96, 0.35), rgba(224, 168, 96, 0.06));
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		animation: rotate-border 3s linear infinite;
		will-change: --border-angle;
	}

	@keyframes rotate-border {
		to {
			--border-angle: 360deg;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#intro-splash {
			display: none;
		}
		#main-content {
			visibility: visible !important;
			opacity: 1 !important;
		}
		.read-paper-cta,
		.metric-card {
			transition: none;
		}
		.metric-card:hover {
			transform: none;
		}
		.highlight-author {
			animation: none;
			border: 1px solid rgba(224, 168, 96, 0.2);
		}
		.highlight-author::before {
			animation: none;
		}
	}
</style>
