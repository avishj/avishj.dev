---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortalBurn from "../../components/PortalBurn.astro";
import BackButton from "../../components/BackButton.astro";
import Footer from "../../components/Footer.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { publications, venueColors, venueLabels, getDisplayAuthors, getAbstractPreview } from "../../data/publications";
import { url } from "../../utils/url";

const pubDisplayAuthors = publications.map((pub) => getDisplayAuthors(pub));
---

<BaseLayout title="Research · Avish Jha" description="Publications, abstracts, and citations from Avish Jha's research.">
	<div id="intro-splash" class="fixed inset-0 z-50 bg-(--color-bg-primary)"></div>
	<PortalBurn />

	<div id="main-content" class="invisible min-h-screen bg-(--color-bg-primary) opacity-0">
		<div class="mx-auto max-w-3xl px-6 lg:px-8">
			<!-- Header -->
			<header class="pb-6 pt-8 lg:pb-8 lg:pt-12">
				<div class="flex items-center gap-4">
					<BackButton fallbackHref={url("")} />
				</div>
				<h1 class="mt-8 font-display text-5xl font-medium italic tracking-tight text-white lg:text-6xl">Research</h1>
			</header>

			<!-- External profiles -->
			<div class="mb-10 flex flex-wrap items-center gap-3">
				<a href="https://scholar.google.com/citations?user=5tb4VWYAAAAJ" target="_blank" rel="noopener noreferrer" class="profile-link press-scale group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-(--color-text-muted)">
					<span>Google Scholar</span>
					<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
				</a>
				<a href="https://orcid.org/0000-0003-1479-0456" target="_blank" rel="noopener noreferrer" class="profile-link press-scale group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-(--color-text-muted)">
					<span>ORCID</span>
					<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
				</a>
				<a href="https://www.semanticscholar.org/author/Avish-Jha/2271492426" target="_blank" rel="noopener noreferrer" class="profile-link press-scale group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-(--color-text-muted)">
					<span>Semantic Scholar</span>
					<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
				</a>
				<a href="https://www.researchgate.net/profile/Avish-Jha" target="_blank" rel="noopener noreferrer" class="profile-link press-scale group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-(--color-text-muted)">
					<span>ResearchGate</span>
					<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
				</a>
				<a href="https://www.webofscience.com/wos/author/record/AAD-2068-2022" target="_blank" rel="noopener noreferrer" class="profile-link press-scale group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-(--color-text-muted)">
					<span>Web of Science</span>
					<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
				</a>
				<a href="https://loop.frontiersin.org/people/1663645/overview" target="_blank" rel="noopener noreferrer" class="profile-link press-scale group flex items-center gap-1.5 rounded border border-white/[0.06] px-3 py-1.5 font-mono text-sm text-(--color-text-muted)">
					<span>Frontiers</span>
					<ArrowIcon class="h-3 w-3 inline-block" hover="white" />
				</a>
			</div>

			<!-- Papers -->
			<main class="pb-16">
				<div class="papers-list space-y-6">
					{
						publications.map((pub, index) => {
							const preview = getAbstractPreview(pub.abstract);
							return (
								<a href={url(`research/${pub.slug}/`)} class="paper-card group block rounded-lg border border-white/[0.06] p-5 md:p-6">
									{/* Top row: badge + year + citation */}
									<div class="mb-2 flex flex-wrap items-center gap-2">
										<span class="rounded px-1.5 py-0.5 font-mono text-xs leading-none" style={`background: ${venueColors[pub.venueType]}20; color: ${venueColors[pub.venueType]};`}>
											{venueLabels[pub.venueType]}
										</span>
										<span class="font-mono text-xs text-(--color-text-muted)">
											{pub.venue} · {pub.year}
										</span>
										{pub.isFirstAuthor && <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-xs leading-none text-white/50">1st Author</span>}
										{pub.citations > 0 && (
											<span class="ml-auto flex items-center gap-1 font-mono text-xs tabular-nums text-(--color-text-muted)">
												<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
													<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
												</svg>
												{pub.citations}
											</span>
										)}
									</div>

									{/* Title */}
									<h2 class="paper-title text-base font-medium leading-relaxed text-white/90 md:text-lg">{pub.title}</h2>

									{/* Authors */}
									<p class="mt-1.5 text-sm leading-relaxed text-(--color-text-muted)">
										{pubDisplayAuthors[index].authors.map((da) => (
											<Fragment>
												{da.isHighlight ? <span class="font-semibold text-white/70">{da.name}</span> : <span>{da.name}</span>}
												{da.separator}
											</Fragment>
										))}
										{pubDisplayAuthors[index].truncated && <span class="italic">et al.</span>}
									</p>

									{/* Abstract preview */}
									{preview && <p class="mt-3 text-sm leading-relaxed text-white/40">{preview}</p>}

									{/* Read more */}
									<div class="mt-4 flex items-center gap-1.5">
										<span class="paper-readmore font-mono text-xs text-(--color-text-muted)">Read more</span>
										<ArrowIcon class="h-3 w-3 inline-block text-(--color-text-muted)" strokeWidth={2} hover="white" />
									</div>
								</a>
							);
						})
					}
				</div>
			</main>

			<Footer />
		</div>
	</div>
</BaseLayout>

<script>
	import { initPageTransition } from "../../utils/portal-transition";
	initPageTransition("intro-splash", "main-content");
</script>

<script>
	import { onIntroComplete } from "../../utils/intro-event";

	async function initResearchPageAnimations() {
		const { scrollRevealTimeline, tlFadeUp, TIMELINE_OVERLAP } = await import("../../utils/scroll-animations");

		const cards = document.querySelectorAll(".paper-card");
		cards.forEach((card) => {
			const badge = card.querySelector(":scope > div:first-child");
			const title = card.querySelector(".paper-title");
			const rest = card.querySelectorAll(":scope > p, :scope > div:last-child");

			scrollRevealTimeline(card, (tl) => {
				tl.fromTo(...tlFadeUp(badge))
					.fromTo(...tlFadeUp(title), TIMELINE_OVERLAP)
					.fromTo(...tlFadeUp(rest, { stagger: 0.04 }), TIMELINE_OVERLAP);
			});
		});
	}

	onIntroComplete(() => initResearchPageAnimations());

	import { groupHoverFade } from "../../utils/group-hover";
	groupHoverFade(".paper-card");
</script>

<style>
	.paper-card {
		transform-origin: left center;
		transition:
			background-color 200ms ease,
			border-color 200ms ease,
			transform 200ms var(--ease-out-expo),
			box-shadow 200ms ease;
		will-change: transform;
	}

	.profile-link {
		transition:
			background-color 200ms ease,
			border-color 200ms ease,
			color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.paper-card:hover {
			background: rgba(255, 255, 255, 0.02);
			border-color: rgba(255, 255, 255, 0.12);
			transform: translateY(-2px);
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
		}

		.paper-card:hover .paper-title {
			color: white;
		}

		.paper-card:hover .paper-readmore {
			color: white;
		}

		.paper-card:active {
			transform: scale(0.98);
			transition: transform 50ms ease;
		}

		.profile-link:hover {
			background: rgba(255, 255, 255, 0.03);
			border-color: rgba(255, 255, 255, 0.12);
			color: white;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#intro-splash {
			display: none;
		}
		#main-content {
			visibility: visible !important;
			opacity: 1 !important;
		}
		.paper-card,
		.profile-link {
			transition: none;
		}
	}
</style>
