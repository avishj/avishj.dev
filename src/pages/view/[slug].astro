---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalBurn from '../../components/PortalBurn.astro';
import BackButton from '../../components/BackButton.astro';
import Footer from '../../components/Footer.astro';
import { url } from '../../utils/url';

export function getStaticPaths() {
  const pdfs: Record<string, { file: string; title: string }> = {
    resume: { file: 'Jha, Avish - Resume.pdf', title: 'Resume' },
    // vit: { file: 'VIT Record.pdf', title: 'VIT Record' },
    // cmu: { file: 'CMU Record.pdf', title: 'CMU Record' },
  };

  return Object.entries(pdfs).map(([slug, data]) => ({
    params: { slug },
    props: data,
  }));
}

const { file, title } = Astro.props;
const pdfUrl = url(`files/${file}`);
const downloadName = file;
---

<BaseLayout title={`${title} · Avish Jha`}>
  <div id="intro-splash" class="fixed inset-0 z-50 bg-[--color-bg-primary]"></div>
  <PortalBurn />

  <div id="main-content" class="invisible min-h-screen bg-[--color-bg-primary] opacity-0">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <header class="flex items-center justify-between pb-6 pt-8 lg:pb-8 lg:pt-12">
        <BackButton href={url("")} text="back" />
        <a href={pdfUrl} download={downloadName} class="download-link group flex items-center gap-1.5 active:scale-[0.97]">
          <span class="download-link-text font-mono text-sm tracking-wide text-white/50 transition-colors duration-150 ease lg:text-base">download</span>
          <svg class="download-link-icon h-3 w-3 text-white/30 lg:h-3.5 lg:w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
          </svg>
        </a>
      </header>

      <h1 class="font-display text-4xl font-medium italic tracking-tight text-white lg:text-5xl">{title}</h1>

      <div id="pdf-container" class="mt-8 flex flex-col items-center gap-6 pb-16">
        <p id="pdf-loading" class="font-mono text-sm text-white/40">Loading PDF...</p>
      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>

<script>
  import { initPageTransition } from "../../utils/portal-transition";
  initPageTransition("intro-splash", "main-content");
</script>

<script is:inline define:vars={{ pdfUrl }}>
  const PDFJS_CDN = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155';

  const script = document.createElement('script');
  script.src = `${PDFJS_CDN}/pdf.min.mjs`;
  script.type = 'module';
  document.head.appendChild(script);

  script.onload = async () => {
    const pdfjsLib = globalThis.pdfjsLib;
    pdfjsLib.GlobalWorkerOptions.workerSrc = `${PDFJS_CDN}/pdf.worker.min.mjs`;

    const container = document.getElementById('pdf-container');
    const loading = document.getElementById('pdf-loading');

    try {
      const pdf = await pdfjsLib.getDocument(pdfUrl).promise;
      const totalPages = pdf.numPages;

      if (loading) loading.remove();

      for (let i = 1; i <= totalPages; i++) {
        const page = await pdf.getPage(i);
        const scale = Math.min(
          (window.innerWidth - 48) / page.getViewport({ scale: 1 }).width,
          2
        );
        const viewport = page.getViewport({ scale });

        const canvas = document.createElement('canvas');
        canvas.width = viewport.width * window.devicePixelRatio;
        canvas.height = viewport.height * window.devicePixelRatio;
        canvas.style.width = `${viewport.width}px`;
        canvas.style.height = `${viewport.height}px`;
        canvas.style.boxShadow = '0 2px 16px rgba(0, 0, 0, 0.4)';
        canvas.style.maxWidth = '100%';
        canvas.style.height = 'auto';

        const ctx = canvas.getContext('2d');
        ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

        container.appendChild(canvas);
        await page.render({ canvasContext: ctx, viewport }).promise;
      }
    } catch (err) {
      if (loading) loading.textContent = 'Failed to load PDF.';
      console.error(err);
    }
  };
</script>

<style>
  .download-link-icon {
    transition:
      color 200ms ease,
      transform 200ms var(--ease-out-expo);
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .download-link:hover .download-link-icon {
      color: rgba(255, 255, 255, 0.7);
      transform: scale(1.35);
    }

    .download-link:hover .download-link-text {
      color: rgba(255, 255, 255, 0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-splash {
      display: none;
    }
    #main-content {
      visibility: visible !important;
      opacity: 1 !important;
    }
    .download-link,
    .download-link-icon {
      transition: none;
    }
  }
</style>
